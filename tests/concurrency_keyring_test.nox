import nox.test
from errors import AmbiguousKeyError, ConfigurationError, KeyUnavailableError, UnknownKeyError
from keys import KeyRef, STATE_ACTIVE_SIGNING, STATE_PREPARED, STATE_REVOKED, STATE_VERIFY_ONLY
from keyring import KeyRing
from rotation import RotationReceipt

# ==============================================================================
# Concurrency & RCU Snapshot Invariant Tests for KeyRing
# ==============================================================================

# Test 1: Snapshot Isolation during concurrent rotation
ring: KeyRing = KeyRing(trust_domain="tenant-prod")
k1: KeyRef = KeyRef("k-001", "HS256", "super-secret-key-material-001-32b", trust_domain="tenant-prod", state=STATE_ACTIVE_SIGNING)
ring.add_key(k1)

# Reader captures current active signing key snapshot
reader_k1: KeyRef = ring.get_signing_key("HS256")
nox.test.assert_eq_str(reader_k1.kid, "k-001", "Reader captured k-001")
nox.test.assert_true(reader_k1.can_sign(), "Reader key can sign")

# Writer performs atomic RCU rotation to k-002
k2: KeyRef = KeyRef("k-002", "HS256", "super-secret-key-material-002-32b", trust_domain="tenant-prod", state=STATE_PREPARED)
receipt1: RotationReceipt = ring.rotate(k2, overlap_seconds=300, clock_time_sec=1000)

# Reader 2 immediately sees the new active key
reader_k2: KeyRef = ring.get_signing_key("HS256")
nox.test.assert_eq_str(reader_k2.kid, "k-002", "Active signer switched atomically to k-002")

# Reader 1 still has its immutable KeyRef representation intact
nox.test.assert_eq_str(reader_k1.kid, "k-001", "Reader 1 reference preserved")

# Verification key lookup for k-001 works (in overlap window)
v1: KeyRef = ring.get_verification_key("k-001", current_time_sec=1100)
nox.test.assert_eq_str(v1.kid, "k-001", "k-001 still verifies during overlap")
nox.test.assert_eq_str(v1.state, STATE_VERIFY_ONLY, "k-001 demoted to VERIFY_ONLY in new snapshot")

# Test 2: Rapid interleaved rotation series — Active signer is never missing or null
step: int = 3
while step <= 20:
    new_kid: str = "k-00" + str(step)
    new_sec: str = "super-secret-key-material-" + str(step) + "-32b"
    next_k: KeyRef = KeyRef(new_kid, "HS256", new_sec, trust_domain="tenant-prod", state=STATE_PREPARED)
    
    # Interleaved reader check right before rotation
    pre_signer: KeyRef = ring.get_signing_key("HS256")
    nox.test.assert_true(pre_signer.can_sign(), "Pre-rotation active signer exists")
    
    # Rotate
    ring.rotate(next_k, overlap_seconds=600, clock_time_sec=1000 + step * 10)
    
    # Interleaved reader check right after rotation
    post_signer: KeyRef = ring.get_signing_key("HS256")
    nox.test.assert_eq_str(post_signer.kid, new_kid, "Post-rotation active signer matches new kid")
    nox.test.assert_true(post_signer.can_sign(), "Post-rotation active signer can sign")
    
    step = step + 1

# Test 3: Failed rotation aborts completely and leaves current snapshot 100% intact
curr_active: KeyRef = ring.get_signing_key("HS256")
nox.test.assert_eq_str(curr_active.kid, "k-0020", "Active before failed rotation is k-0020")

# Attempt 1: Cross-tenant key during rotation
foreign_key: KeyRef = KeyRef("k-bad-domain", "HS256", "super-secret-key-material-foreign-32", trust_domain="tenant-evil", state=STATE_PREPARED)
domain_failed: bool = False
try:
    ring.rotate(foreign_key, overlap_seconds=300, clock_time_sec=2000)
except ConfigurationError:
    domain_failed = True
nox.test.assert_true(domain_failed, "Cross-tenant rotation failed")

# KeyRing snapshot must NOT have changed:
active_after_fail1: KeyRef = ring.get_signing_key("HS256")
nox.test.assert_eq_str(active_after_fail1.kid, "k-0020", "Active key unchanged after domain failure")
nox.test.assert_true(active_after_fail1.can_sign(), "Active key can still sign")

# Attempt 2: Duplicate kid during rotation
dup_key: KeyRef = KeyRef("k-0010", "HS256", "super-secret-duplicate-key-material-32", trust_domain="tenant-prod", state=STATE_PREPARED)
dup_failed: bool = False
try:
    ring.rotate(dup_key, overlap_seconds=300, clock_time_sec=2000)
except AmbiguousKeyError:
    dup_failed = True
nox.test.assert_true(dup_failed, "Duplicate kid rotation failed")

active_after_fail2: KeyRef = ring.get_signing_key("HS256")
nox.test.assert_eq_str(active_after_fail2.kid, "k-0020", "Active key unchanged after duplicate kid failure")

# Test 4: RCU Revocation semantics
# Revoke k-0020
ring.revoke("k-0020")

# Verification of revoked key must fail
revoked_check_failed: bool = False
try:
    ring.get_verification_key("k-0020")
except KeyUnavailableError:
    revoked_check_failed = True
nox.test.assert_true(revoked_check_failed, "Revoked key immediately unavailable for verification")

# Cannot sign with revoked key
signing_failed: bool = False
try:
    ring.get_signing_key("HS256")
except KeyUnavailableError:
    signing_failed = True
nox.test.assert_true(signing_failed, "No active signing key after revoking the active signer")

# Revoking unknown key fails closed without altering snapshot
unknown_revoke_failed: bool = False
try:
    ring.revoke("k-ghost")
except UnknownKeyError:
    unknown_revoke_failed = True
nox.test.assert_true(unknown_revoke_failed, "Revoking non-existent key fails closed with UnknownKeyError")

# ==============================================================================
# Test 5: P0 Optimistic Concurrency Control (CAS) & Multi-Writer Coordination (0.9.2)
# ==============================================================================
cas_ring: KeyRing = KeyRing(trust_domain="tenant-cas")
nox.test.assert_eq_int(cas_ring.get_version(), 0, "Initial keyring version is 0")

cas_k1: KeyRef = KeyRef("k-cas-1", "HS256", "super-secret-cas-material-001-32b", trust_domain="tenant-cas", state=STATE_ACTIVE_SIGNING)
cas_ring.add_key(cas_k1, expected_version=0)
nox.test.assert_eq_int(cas_ring.get_version(), 1, "KeyRing version increments to 1 after add_key")

# Concurrent writer simulation:
# Writer A reads version 1
v_reader_a: int = cas_ring.get_version()
nox.test.assert_eq_int(v_reader_a, 1, "Writer A reads version 1")

# Writer B also reads version 1
v_reader_b: int = cas_ring.get_version()
nox.test.assert_eq_int(v_reader_b, 1, "Writer B reads version 1")

# Writer A succeeds in rotating first (commit with expected_version=1)
cas_k2: KeyRef = KeyRef("k-cas-2", "HS256", "super-secret-cas-material-002-32b", trust_domain="tenant-cas", state=STATE_PREPARED)
rec_a: RotationReceipt = cas_ring.rotate(cas_k2, overlap_seconds=3600, clock_time_sec=1000, expected_version=v_reader_a)
nox.test.assert_eq_str(rec_a.new_kid, "k-cas-2", "Writer A rotation succeeded")
nox.test.assert_eq_int(cas_ring.get_version(), 2, "KeyRing version increments to 2 after Writer A commit")

# Writer B attempts rotation using stale expected_version=1 -> MUST FAIL (Conflict detected)
cas_k3: KeyRef = KeyRef("k-cas-3", "HS256", "super-secret-cas-material-003-32b", trust_domain="tenant-cas", state=STATE_PREPARED)
cas_b_conflict_detected: bool = False
try:
    cas_ring.rotate(cas_k3, overlap_seconds=3600, clock_time_sec=1000, expected_version=v_reader_b)
except ConfigurationError:
    cas_b_conflict_detected = True
nox.test.assert_true(cas_b_conflict_detected, "Writer B rotation rejected with ConfigurationError due to version conflict")

# KeyRing must remain at version 2, and active signer must remain k-cas-2
nox.test.assert_eq_int(cas_ring.get_version(), 2, "KeyRing version remains 2 after failed CAS")
cas_signer: KeyRef = cas_ring.get_signing_key("HS256")
nox.test.assert_eq_str(cas_signer.kid, "k-cas-2", "Active signer is still k-cas-2 after conflict")

# CAS Revoke test:
# Revoke with wrong expected_version must fail
revoke_conflict_detected: bool = False
try:
    cas_ring.revoke("k-cas-1", expected_version=99)
except ConfigurationError:
    revoke_conflict_detected = True
nox.test.assert_true(revoke_conflict_detected, "Revoke rejected when expected_version does not match")

# Revoke with correct version succeeds
cas_ring.revoke("k-cas-1", expected_version=2)
nox.test.assert_eq_int(cas_ring.get_version(), 3, "Version increments to 3 after CAS revoke")

# Snapshot defensive cloning verification
snap_list: list[KeyRef] = cas_ring.get_snapshot()
nox.test.assert_eq_int(len(snap_list), 2, "Snapshot has 2 keys")
snap_list[0].kid = "corrupted-in-snapshot"
active_after_snap_tamper: KeyRef = cas_ring.get_signing_key("HS256")
nox.test.assert_eq_str(active_after_snap_tamper.kid, "k-cas-2", "Tampering with get_snapshot() list does not corrupt KeyRing")

# ==============================================================================
# Test 6: P0 Unified KeyRingState & Interleaved Lost-Update Protection (0.10.2)
# ==============================================================================
state_ring: KeyRing = KeyRing(trust_domain="tenant-atomic")
init_k: KeyRef = KeyRef("k-atom-1", "HS256", "super-secret-key-material-atomic-32", trust_domain="tenant-atomic", state=STATE_ACTIVE_SIGNING)
state_ring.add_key(init_k)

# 6a. Single immutable KeyRingState object verification
nox.test.assert_eq_int(state_ring.state.version, 1, "KeyRingState encapsulates version 1")
nox.test.assert_eq_int(len(state_ring.state.keys), 1, "KeyRingState encapsulates keys array")
nox.test.assert_true(state_ring.state.created_at > 0, "KeyRingState tracks creation timestamp")

# 6b. True Lost-Update Detection Simulation:
# Two concurrent writers W1 and W2 both capture base state at version 1
w1_base_ver: int = state_ring.get_version()
w2_base_ver: int = state_ring.get_version()
nox.test.assert_eq_int(w1_base_ver, 1, "W1 reads version 1")
nox.test.assert_eq_int(w2_base_ver, 1, "W2 reads version 1")

# W1 completes preparation and commits rotate to k-atom-2
w1_key: KeyRef = KeyRef("k-atom-2", "HS256", "super-secret-key-material-w1-key-32", trust_domain="tenant-atomic", state=STATE_PREPARED)
rec_w1: RotationReceipt = state_ring.rotate(w1_key, overlap_seconds=600, clock_time_sec=2000, expected_version=w1_base_ver)
nox.test.assert_eq_str(rec_w1.new_kid, "k-atom-2", "W1 successfully committed")
nox.test.assert_eq_int(state_ring.get_version(), 2, "State version advanced to 2")

# W2 attempts commit using its stale base version (1) -> Must be rejected immediately!
w2_key: KeyRef = KeyRef("k-atom-3", "HS256", "super-secret-key-material-w2-key-32", trust_domain="tenant-atomic", state=STATE_PREPARED)
w2_lost_update_caught: bool = False
try:
    state_ring.rotate(w2_key, overlap_seconds=600, clock_time_sec=2000, expected_version=w2_base_ver)
except ConfigurationError:
    w2_lost_update_caught = True
nox.test.assert_true(w2_lost_update_caught, "W2 rotate rejected: CAS / lost-update prevented")

# Verify state remains at version 2 and W1's active signer is preserved
nox.test.assert_eq_int(state_ring.get_version(), 2, "KeyRing version remains 2 after conflicting write aborted")
current_active: KeyRef = state_ring.get_signing_key("HS256")
nox.test.assert_eq_str(current_active.kid, "k-atom-2", "W1's active signer was NOT overwritten by W2")

print("concurrency_keyring_test passed!")
