import nox.test
from errors import InvalidKeyError, JsonFormatError
from jwk import JwkKey, parse_jwk

# 1. RFC 7638 Section 3.1 Official Test Vector
rfc_jwk_json: str = "{\"kty\":\"RSA\",\"n\":\"0vx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw\",\"e\":\"AQAB\",\"alg\":\"RS256\",\"kid\":\"2011-04-29\"}"

key: JwkKey = parse_jwk(rfc_jwk_json)
nox.test.assert_eq_str(key.kty, "RSA", "Parsed kty matches RSA")
nox.test.assert_eq_str(key.kid, "2011-04-29", "Parsed kid matches")
nox.test.assert_true(not key.is_private(), "Public key reported as not private")

# Verify RFC 7638 SHA-256 Thumbprint
expected_thumbprint: str = "NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs"
thumbprint: str = key.thumbprint_sha256()
nox.test.assert_eq_str(thumbprint, expected_thumbprint, "RFC 7638 thumbprint exact match")

# 2. Public Export Safety: Private material stripping
rsa_with_private_json: str = "{\"kty\":\"RSA\",\"n\":\"0vx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw\",\"e\":\"AQAB\",\"d\":\"synthetic-private-exponent-not-to-be-leaked\",\"kid\":\"sec-key-1\"}"

private_key: JwkKey = parse_jwk(rsa_with_private_json)
nox.test.assert_true(private_key.is_private(), "Private key detected")

public_exported: str = private_key.to_public_json()
nox.test.assert_true(not nox.strings.contains(public_exported, "\"d\":"), "Public JSON MUST NOT contain 'd' private exponent")
nox.test.assert_true(not nox.strings.contains(public_exported, "synthetic-private"), "Public JSON MUST NOT contain private secret values")
nox.test.assert_true(nox.strings.contains(public_exported, "\"kty\":\"RSA\""), "Public JSON contains RSA kty")

# 3. Negative: Symmetric key public export is strictly prohibited
sym_jwk_json: str = "{\"kty\":\"oct\",\"k\":\"c3VwZXItc2VjcmV0LWtleS1hdC1sZWFzdC0zMi1ieXRlcw\",\"kid\":\"sym-1\"}"
sym_key: JwkKey = parse_jwk(sym_jwk_json)

sym_export_blocked: bool = False
try:
    sym_key.to_public_json()
except InvalidKeyError:
    sym_export_blocked = True
nox.test.assert_true(sym_export_blocked, "Symmetric octet key public export must fail closed")

# 4. Negative: Weak RSA key (<2048 bits / <256 bytes) rejected
weak_rsa_json: str = "{\"kty\":\"RSA\",\"n\":\"c2hvcnQtbW9kdWx1cy11bmRlci0yMDQ4LWJpdHM\",\"e\":\"AQAB\"}"
weak_rejected: bool = False
try:
    parse_jwk(weak_rsa_json)
except InvalidKeyError:
    weak_rejected = True
nox.test.assert_true(weak_rejected, "RSA key with modulus < 2048 bits must be rejected")

# 5. Negative: Missing mandatory RSA parameters
missing_param_json: str = "{\"kty\":\"RSA\",\"e\":\"AQAB\"}"
missing_rejected: bool = False
try:
    parse_jwk(missing_param_json)
except InvalidKeyError:
    missing_rejected = True
nox.test.assert_true(missing_rejected, "RSA key missing 'n' must be rejected")

# 6. Negative: 342-char modulus with invalid Base64URL syntax rejected
bad_syntax_n: str = "0vx7+goebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw"
bad_syntax_json: str = "{\"kty\":\"RSA\",\"n\":\"" + bad_syntax_n + "\",\"e\":\"AQAB\"}"
bad_syntax_rejected: bool = False
try:
    parse_jwk(bad_syntax_json)
except InvalidKeyError:
    bad_syntax_rejected = True
nox.test.assert_true(bad_syntax_rejected, "RSA modulus with '+' must be rejected")

# 7. Negative: 342-char modulus with leading zero octet rejected
zero_octet_n: str = "AAAAagoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw"
zero_octet_json: str = "{\"kty\":\"RSA\",\"n\":\"" + zero_octet_n + "\",\"e\":\"AQAB\"}"
zero_octet_rejected: bool = False
try:
    parse_jwk(zero_octet_json)
except InvalidKeyError:
    zero_octet_rejected = True
nox.test.assert_true(zero_octet_rejected, "RSA modulus with leading zero octet must be rejected")

# 8. Negative: 342-char modulus with MSB = 0 rejected (fewer than 2048 bits)
msb_zero_n: str = "Avx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw"
msb_zero_json: str = "{\"kty\":\"RSA\",\"n\":\"" + msb_zero_n + "\",\"e\":\"AQAB\"}"
msb_zero_rejected: bool = False
try:
    parse_jwk(msb_zero_json)
except InvalidKeyError:
    msb_zero_rejected = True
nox.test.assert_true(msb_zero_rejected, "RSA modulus with MSB=0 (fewer than 2048 bits) must be rejected")

# 9. Negative: Even RSA public exponent rejected
even_e_json: str = "{\"kty\":\"RSA\",\"n\":\"" + key.n + "\",\"e\":\"Ag\"}"
even_e_rejected: bool = False
try:
    parse_jwk(even_e_json)
except InvalidKeyError:
    even_e_rejected = True
nox.test.assert_true(even_e_rejected, "Even RSA public exponent must be rejected")

# 10. Negative: RSA public exponent <= 1 rejected
small_e_json: str = "{\"kty\":\"RSA\",\"n\":\"" + key.n + "\",\"e\":\"AQ\"}"
small_e_rejected: bool = False
try:
    parse_jwk(small_e_json)
except InvalidKeyError:
    small_e_rejected = True
nox.test.assert_true(small_e_rejected, "RSA public exponent <= 1 must be rejected")

# P0: Excessive RSA public exponent length & overflow protection (0.9.3)
excessive_e_json: str = "{\"kty\":\"RSA\",\"kid\":\"rsa-overflow\",\"n\":\"" + key.n + "\",\"e\":\"AQABAAAAAAAAAAAAAAAA\"}"
excessive_e_rejected: bool = False
try:
    parse_jwk(excessive_e_json)
except InvalidKeyError:
    excessive_e_rejected = True
nox.test.assert_true(excessive_e_rejected, "RSA public exponent exceeding MAX_RSA_EXPONENT_CHARS must be rejected")

