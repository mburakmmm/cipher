import nox.mem
import nox.strings
import nox.test
from claims import ClaimsProfile
from encoding import decode_base64url
from errors import DisallowedAlgorithmError, InvalidKeyError, InvalidSignatureError, UnsupportedAlgorithmError
from jwk import JwkKey, parse_jwk
from jws import VerificationProfile, VerifiedJws, sign_jws, verify_jws
from jwt import VerifiedJwt, encode_jwt, verify_jwt
from openssl_provider import OpenSslCryptoProvider, is_openssl_available
from provider import DefaultCryptoProvider

nox.test.assert_true(is_openssl_available(), "OpenSSL libcrypto must load via optional C shim")
ossl: OpenSslCryptoProvider = OpenSslCryptoProvider()
nox.test.assert_eq_str(ossl.provider_name(), "openssl-libcrypto-ffi", "Provider name matches")
nox.test.assert_true(ossl.supports_algorithm("RS256"), "Supports RS256")
nox.test.assert_true(ossl.supports_algorithm("PS256"), "Supports PS256")
nox.test.assert_true(ossl.supports_algorithm("ES256"), "Supports ES256")
nox.test.assert_true(ossl.supports_algorithm("EdDSA"), "Supports EdDSA")
nox.test.assert_true(ossl.supports_algorithm("HS384"), "Supports HS384")
nox.test.assert_true(ossl.supports_algorithm("HS512"), "Supports HS512")

# ------------------------------------------------------------------------------
# 1. HS384 & HS512 Roundtrip + Secret Size Enforcement
# ------------------------------------------------------------------------------
hs384_secret: str = "hs384-production-secret-key-at-least-48-bytes-long!"
hs512_secret: str = "hs512-production-secret-key-material-at-least-64-bytes-long-01234567"

tok_384: str = sign_jws("{\"scope\":\"read\"}", "HS384", hs384_secret, kid="hs384-1", provider=ossl)
v_384: VerifiedJws = verify_jws(tok_384, hs384_secret, VerificationProfile(["HS384"], expected_kid="hs384-1"), provider=ossl)
nox.test.assert_eq_str(v_384.algorithm, "HS384", "HS384 verified")
nox.test.assert_eq_str(v_384.payload, "{\"scope\":\"read\"}", "HS384 payload matches")

tok_512: str = sign_jws("{\"scope\":\"write\"}", "HS512", hs512_secret, kid="hs512-1", provider=ossl)
v_512: VerifiedJws = verify_jws(tok_512, hs512_secret, VerificationProfile(["HS512"], expected_kid="hs512-1"), provider=ossl)
nox.test.assert_eq_str(v_512.algorithm, "HS512", "HS512 verified")

short_512_rejected: bool = False
try:
    sign_jws("{}", "HS512", "only-32-bytes-long-secret-012345", provider=ossl)
except InvalidKeyError:
    short_512_rejected = True
nox.test.assert_true(short_512_rejected, "HS512 secret < 64 bytes rejected")

# ------------------------------------------------------------------------------
# 2. EdDSA (Ed25519) Sign via OpenSSL + Cross-Verify via Pure NOX stdlib
# ------------------------------------------------------------------------------
ed_priv_jwk: str = "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"d\":\"nWGxne_9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}"
ed_pub_jwk: str = "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}"

ed_token: str = sign_jws("Example of Ed25519 signing", "EdDSA", ed_priv_jwk, kid="ed-1", typ="JWT", provider=ossl)
v_ed_ossl: VerifiedJws = verify_jws(ed_token, ed_pub_jwk, VerificationProfile(["EdDSA"], expected_kid="ed-1"), provider=ossl)
v_ed_pure: VerifiedJws = verify_jws(ed_token, ed_pub_jwk, VerificationProfile(["EdDSA"], expected_kid="ed-1"), provider=DefaultCryptoProvider())
nox.test.assert_eq_str(v_ed_ossl.payload, "Example of Ed25519 signing", "OpenSSL Ed25519 sign/verify roundtrip")
nox.test.assert_eq_str(v_ed_pure.payload, "Example of Ed25519 signing", "OpenSSL-signed Ed25519 verified by pure-NOX stdlib")

# Exact RFC 8037 signature equivalence check via OpenSSL sign over raw signing input
rfc_sig_raw: str = ossl.sign_asymmetric("EdDSA", ed_priv_jwk, "eyJhbGciOiJFZERTQSJ9.RXhhbXBsZSBvZiBFZDI1NTE5IHNpZ25pbmc")
nox.test.assert_eq_int(nox.strings.byte_len(rfc_sig_raw), 64, "Ed25519 signature is 64 raw bytes")

# ------------------------------------------------------------------------------
