rsa_pub_pem: str = "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAikg6m1utniv0MlO9y6us\nfg1mZWWiuEEfR/6KwawNkUSqC/qbu67pTb2CfKDv1ghUpj8Go5lqYD/sBhmdIYx/\nE51C0bh4H5WOfE77xgEVRyqk7lC2gy9GItzTf1c8c5a5XZrQGcpuuGPokOrpfn+V\nuGp2noxxKYh2Owl6N769nT2cPjtLEoSNVwbUspc60cVr7ysGH8nw3ozGq6F/1Dvs\ngyOU4E39z8Evm4vQn9RmAs7DbGEGSnamPn/y63xlEIyedsYCy4zpYwH1z4RTKiQV\nu5kF2Xor1Its6Ssbz/kYMVstDoh4y8BjY9I83t3PMdkmQjp5cAwLbR06+HcXYRnv\nlwIDAQAB\n-----END PUBLIC KEY-----\n"
rsa_pub_jwk: str = "{\"kty\":\"RSA\",\"kid\":\"rsa-2048-1\",\"n\":\"ikg6m1utniv0MlO9y6usfg1mZWWiuEEfR_6KwawNkUSqC_qbu67pTb2CfKDv1ghUpj8Go5lqYD_sBhmdIYx_E51C0bh4H5WOfE77xgEVRyqk7lC2gy9GItzTf1c8c5a5XZrQGcpuuGPokOrpfn-VuGp2noxxKYh2Owl6N769nT2cPjtLEoSNVwbUspc60cVr7ysGH8nw3ozGq6F_1DvsgyOU4E39z8Evm4vQn9RmAs7DbGEGSnamPn_y63xlEIyedsYCy4zpYwH1z4RTKiQVu5kF2Xor1Its6Ssbz_kYMVstDoh4y8BjY9I83t3PMdkmQjp5cAwLbR06-HcXYRnvlw\",\"e\":\"AQAB\"}"

jwt_claims: str = "{\"iss\":\"https://auth.nox.dev\",\"sub\":\"usr_rsa\",\"aud\":\"api://core\",\"exp\":1800003600,\"iat\":1800000000}"
c_prof: ClaimsProfile = ClaimsProfile(expected_issuer="https://auth.nox.dev", clock_time_sec=1800000100).with_audience("api://core")

rs256_jwt: str = encode_jwt(jwt_claims, "RS256", rsa_priv_pem, kid="rsa-2048-1", provider=ossl)
rs256_ver_pem: VerifiedJwt = verify_jwt(rs256_jwt, rsa_pub_pem, VerificationProfile(["RS256"], expected_kid="rsa-2048-1"), c_prof, provider=ossl)
rs256_ver_jwk: VerifiedJwt = verify_jwt(rs256_jwt, rsa_pub_jwk, VerificationProfile(["RS256"], expected_kid="rsa-2048-1"), c_prof, provider=ossl)
nox.test.assert_eq_str(rs256_ver_pem.claims.sub, "usr_rsa", "RS256 JWT PEM verify matches")
nox.test.assert_eq_str(rs256_ver_jwk.claims.sub, "usr_rsa", "RS256 JWT JWK verify matches")

ps256_jwt: str = encode_jwt(jwt_claims, "PS256", rsa_priv_pem, kid="rsa-2048-1", provider=ossl)
ps256_ver_jwk: VerifiedJwt = verify_jwt(ps256_jwt, rsa_pub_jwk, VerificationProfile(["PS256"], expected_kid="rsa-2048-1"), c_prof, provider=ossl)
nox.test.assert_eq_str(ps256_ver_jwk.claims.sub, "usr_rsa", "PS256 JWT JWK verify matches")

# Cross-padding check: PS256 token submitted to RS256-only verifier MUST fail closed
ps_vs_rs_rejected: bool = False
try:
    verify_jwt(ps256_jwt, rsa_pub_jwk, VerificationProfile(["RS256"], expected_kid="rsa-2048-1"), c_prof, provider=ossl)
except DisallowedAlgorithmError:
    ps_vs_rs_rejected = True
nox.test.assert_true(ps_vs_rs_rejected, "PS256 token rejected by RS256 allowlist")

# Weak 1024-bit RSA key MUST fail closed
