weak_rsa_sign_rejected: bool = False
try:
    sign_jws("{}", "RS256", weak_rsa_priv_pem, provider=ossl)
except InvalidKeyError:
    weak_rsa_sign_rejected = True
nox.test.assert_true(weak_rsa_sign_rejected, "RSA < 2048 bits signing rejected fail closed")

# ------------------------------------------------------------------------------
# 4. ES256 (ECDSA P-256 PEM Sign -> 64-byte raw R||S -> PEM & JWK Verify)
# ------------------------------------------------------------------------------
ec_priv_pem: str = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgwJ4fTJdV7Hfv29Ut\nfKSlRGkSWZ8fLUvIttVnSWp/cvahRANCAAS7sH0AzE3bzBPMiHQpPMjnr77Ebi3H\nkY83K48NbwUTElx7v9COfSgfRFqgEh0OEJLSLod+/boZyY3xe1wBRPji\n-----END PRIVATE KEY-----\n"
ec_pub_pem: str = "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEu7B9AMxN28wTzIh0KTzI56++xG4t\nx5GPNyuPDW8FExJce7/Qjn0oH0RaoBIdDhCS0i6Hfv26GcmN8XtcAUT44g==\n-----END PUBLIC KEY-----\n"
ec_pub_jwk: str = "{\"kty\":\"EC\",\"crv\":\"P-256\",\"kid\":\"ec-p256-1\",\"x\":\"u7B9AMxN28wTzIh0KTzI56--xG4tx5GPNyuPDW8FExI\",\"y\":\"XHu_0I59KB9EWqASHQ4QktIuh379uhnJjfF7XAFE-OI\"}"

parsed_ec_jwk: JwkKey = parse_jwk(ec_pub_jwk)
nox.test.assert_eq_str(parsed_ec_jwk.crv, "P-256", "EC P-256 JWK parsed")

es256_jwt: str = encode_jwt(jwt_claims, "ES256", ec_priv_pem, kid="ec-p256-1", provider=ossl)
es256_parts: list[str] = nox.strings.split(es256_jwt, ".")
nox.test.assert_eq_int(nox.strings.byte_len(decode_base64url(es256_parts[2])), 64, "ES256 signature uses fixed-width 64-byte JOSE R||S encoding")

es256_ver_pem: VerifiedJwt = verify_jwt(es256_jwt, ec_pub_pem, VerificationProfile(["ES256"], expected_kid="ec-p256-1"), c_prof, provider=ossl)
es256_ver_jwk: VerifiedJwt = verify_jwt(es256_jwt, ec_pub_jwk, VerificationProfile(["ES256"], expected_kid="ec-p256-1"), c_prof, provider=ossl)
nox.test.assert_eq_str(es256_ver_pem.claims.sub, "usr_rsa", "ES256 JWT PEM verify matches")
nox.test.assert_eq_str(es256_ver_jwk.claims.sub, "usr_rsa", "ES256 JWT EC JWK verify matches")

# Tampered ES256 payload MUST fail closed
tampered_es256: str = es256_parts[0] + ".eyJzdWIiOiJoYWNrZWQifQ." + es256_parts[2]
es_tamper_rejected: bool = False
try:
    verify_jws(tampered_es256, ec_pub_jwk, VerificationProfile(["ES256"], expected_kid="ec-p256-1"), provider=ossl)
except InvalidSignatureError:
    es_tamper_rejected = True
nox.test.assert_true(es_tamper_rejected, "Tampered ES256 payload rejected")

# Key-family confusion: RSA JWK passed for ES256 verification
rsa_vs_es_rejected: bool = False
try:
    verify_jws(es256_jwt, rsa_pub_jwk, VerificationProfile(["ES256"], expected_kid="ec-p256-1"), provider=ossl)
except InvalidKeyError:
    rsa_vs_es_rejected = True
nox.test.assert_true(rsa_vs_es_rejected, "RSA JWK passed to ES256 verification rejected")

# Malformed ES256 signature length (63 bytes instead of 64)
bad_len_es_sig: str = es256_parts[0] + "." + es256_parts[1] + ".AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
bad_len_rejected: bool = False
try:
    verify_jws(bad_len_es_sig, ec_pub_jwk, VerificationProfile(["ES256"], expected_kid="ec-p256-1"), provider=ossl)
except InvalidSignatureError:
    bad_len_rejected = True
nox.test.assert_true(bad_len_rejected, "Non-64-byte ES256 signature rejected")

# ------------------------------------------------------------------------------
# 6. C FFI + ARC Memory Regression Check (nox.mem.stats())
# ------------------------------------------------------------------------------
def _run_openssl_mem_cycle(prov: OpenSslCryptoProvider, priv_pem: str, pub_pem: str) -> int:
    prof: VerificationProfile = VerificationProfile(["ES256"], expected_kid="ec-mem")
    passed: int = 0
    i: int = 0
    while i < 20:
        t: str = sign_jws("{\"m\":" + str(i) + "}", "ES256", priv_pem, kid="ec-mem", provider=prov)
        v: VerifiedJws = verify_jws(t, pub_pem, prof, provider=prov)
        if v.kid == "ec-mem":
            passed = passed + 1
        i = i + 1
    return passed

_m0: int = _run_openssl_mem_cycle(ossl, ec_priv_pem, ec_pub_pem)
nox.test.assert_eq_int(_m0, 20, "OpenSSL FFI warmup passed")
nox.mem.stats()
_m1: int = _run_openssl_mem_cycle(ossl, ec_priv_pem, ec_pub_pem)
ossl_mem: nox.mem.MemStats = nox.mem.stats()
nox.test.assert_eq_int(_m1, 20, "OpenSSL FFI cycle passed under nox.mem.stats()")
nox.test.assert_true(ossl_mem.live <= 4, "Zero C/ARC memory growth after OpenSSL ES256 FFI cycle (live=" + str(ossl_mem.live) + ")")

print("openssl_provider_test passed!")
