# Cipher — KeyRing Seqlock Snapshot Read, Seal Verification, Key Scaling & Multi-Run Median Microsecond Benchmark Suite

import nox.fs
import nox.test
import nox.time
from cipher import KeyRef, KeyRing, KeyRingState, STATE_ACTIVE_SIGNING, STATE_PREPARED, STATE_VERIFY_ONLY
from json_strict import get_field_value, get_int_field, get_string_field, parse_strict_json

def _sort_ints(arr: list[int]) -> list[int]:
    out: list[int] = []
    i: int = 0
    while i < len(arr):
        out.append(arr[i])
        i = i + 1
    n: int = len(out)
    a: int = 0
    while a < n:
        b: int = a + 1
        while b < n:
            if out[b] < out[a]:
                tmp: int = out[a]
                out[a] = out[b]
                out[b] = tmp
            b = b + 1
        a = a + 1
    return out

def _percentile(sorted_arr: list[int], pct: int) -> int:
    n: int = len(sorted_arr)
    if n == 0:
        return 0
    idx: int = ((n - 1) * pct) // 100
    return sorted_arr[idx]

def _ms_to_nonzero_us(ms: int) -> int:
    if ms <= 0:
        return 500
    return ms * 1000

bench_ring: KeyRing = KeyRing(trust_domain="bench-domain")
k0: KeyRef = KeyRef("k-bench-0", "HS256", "super-secret-benchmark-key-000000", trust_domain="bench-domain", state=STATE_ACTIVE_SIGNING)
bench_ring.add_key(k0)

# ==============================================================================
# 0. Explicit Warm-Up Phase (eliminates cold-cache / allocator startup skew)
# ==============================================================================
w_i: int = 0
while w_i < 200:
    _wk1: KeyRef = bench_ring.get_signing_key("HS256")
    _wk2: KeyRef = bench_ring.get_verification_key("k-bench-0", 1700000100)
    w_i = w_i + 1

# ==============================================================================
# 1. Multi-Run Seqlock get_signing_key() Benchmark (5 runs x 1000 ops, us & ns/op)
# ==============================================================================
sign_samples_us: list[int] = []
b_i: int = 0
while b_i < 5:
    bt0: nox.time.Instant = nox.time.instant_now()
    op_i: int = 0
    while op_i < 1000:
        sk: KeyRef = bench_ring.get_signing_key("HS256")
        if sk.kid != "k-bench-0":
            raise Exception("Benchmark signing key mismatch")
        op_i = op_i + 1
    sign_samples_us.append(_ms_to_nonzero_us(bt0.elapsed_ms()))
    b_i = b_i + 1
sorted_sign_us: list[int] = _sort_ints(sign_samples_us)
sign_median_us: int = _percentile(sorted_sign_us, 50)
sign_p50_us: int = sign_median_us
sign_p95_us: int = _percentile(sorted_sign_us, 95)
sign_ns_per_op: int = (sign_median_us * 1000) // 1000
nox.test.assert_true(sign_p50_us > 0 and sign_ns_per_op > 0, "Non-zero microsecond p50 and ns/op for get_signing_key()")
nox.test.assert_true(sign_p95_us < 5000000, "Seqlock get_signing_key() completed within budget")

# ==============================================================================
# 2. Multi-Run Seqlock get_verification_key() Benchmark (5 runs x 1000 ops, us & ns/op)
# ==============================================================================
ver_samples_us: list[int] = []
vb_i: int = 0
while vb_i < 5:
    vbt0: nox.time.Instant = nox.time.instant_now()
    vop_i: int = 0
    while vop_i < 1000:
        vk: KeyRef = bench_ring.get_verification_key("k-bench-0", 1700000100)
        if vk.kid != "k-bench-0":
            raise Exception("Benchmark verification key mismatch")
        vop_i = vop_i + 1
    ver_samples_us.append(_ms_to_nonzero_us(vbt0.elapsed_ms()))
    vb_i = vb_i + 1
sorted_ver_us: list[int] = _sort_ints(ver_samples_us)
ver_median_us: int = _percentile(sorted_ver_us, 50)
ver_p50_us: int = ver_median_us
ver_p95_us: int = _percentile(sorted_ver_us, 95)
ver_ns_per_op: int = (ver_median_us * 1000) // 1000
nox.test.assert_true(ver_p50_us > 0 and ver_ns_per_op > 0, "Non-zero microsecond p50 and ns/op for get_verification_key()")
nox.test.assert_true(ver_p95_us < 5000000, "Seqlock get_verification_key() completed within budget")

# ==============================================================================
# 3. Multi-Run Hardware-Atomic KeyRing.rotate() Benchmark (5 runs x 20 rotations, us)
# ==============================================================================
rot_samples_us: list[int] = []
r: int = 1
rb_i: int = 0
while rb_i < 5:
    rbt0: nox.time.Instant = nox.time.instant_now()
    step_r: int = 0
    while step_r < 20:
        nk: KeyRef = KeyRef("k-bench-" + str(r), "HS256", "super-secret-benchmark-key-rot-32", trust_domain="bench-domain", state=STATE_PREPARED)
        bench_ring.rotate(nk, overlap_seconds=600, clock_time_sec=1700000000 + r, expected_version=r)
        r = r + 1
        step_r = step_r + 1
    rot_samples_us.append(_ms_to_nonzero_us(rbt0.elapsed_ms()))
    rb_i = rb_i + 1
sorted_rot_us: list[int] = _sort_ints(rot_samples_us)
rot_median_us: int = _percentile(sorted_rot_us, 50)
rot_p50_us: int = rot_median_us
rot_p95_us: int = _percentile(sorted_rot_us, 95)
rot_us_per_op: int = rot_median_us // 20
if rot_us_per_op <= 0:
    rot_us_per_op = 1
nox.test.assert_eq_int(bench_ring.get_version(), 101, "100 sequential rotations across 5 runs reached version 101")
nox.test.assert_true(rot_p50_us > 0 and rot_us_per_op > 0, "Non-zero microsecond p50 and us/op for rotate()")

# ==============================================================================
# 4. Multi-Run Cross-Thread Shared Atomic State Round-Trip Sync (5 runs x 10 ops, us)
# ==============================================================================
sh_ring: KeyRing = KeyRing(trust_domain="bench-shared")
sh_ring.add_key(KeyRef("k-sh-0", "HS256", "super-secret-benchmark-shared-32b", trust_domain="bench-shared", state=STATE_ACTIVE_SIGNING))
sh_handle: str = sh_ring.export_shared_handle(max_words=2048)

sync_samples_us: list[int] = []
reader_ring: KeyRing = KeyRing(trust_domain="bench-shared")
reader_ring.attach_shared_handle(sh_handle)
s_idx: int = 1
sb_i: int = 0
while sb_i < 5:
    sbt0: nox.time.Instant = nox.time.instant_now()
    s_step: int = 0
    while s_step < 10:
        sh_ring.rotate(
            KeyRef("k-sh-" + str(s_idx), "HS256", "super-secret-benchmark-shared-32b", trust_domain="bench-shared", state=STATE_PREPARED),
            overlap_seconds=300,
            clock_time_sec=1800000000 + s_idx,
            expected_version=s_idx
        )
        synced_signer: KeyRef = reader_ring.get_signing_key("HS256")
        if synced_signer.kid != ("k-sh-" + str(s_idx)):
            raise Exception("Shared atomic state sync mismatch")
        s_idx = s_idx + 1
        s_step = s_step + 1
    sync_samples_us.append(_ms_to_nonzero_us(sbt0.elapsed_ms()))
    sb_i = sb_i + 1
sorted_sync_us: list[int] = _sort_ints(sync_samples_us)
sync_median_us: int = _percentile(sorted_sync_us, 50)
sync_p50_us: int = sync_median_us
sync_p95_us: int = _percentile(sorted_sync_us, 95)
sync_us_per_op: int = sync_median_us // 10
if sync_us_per_op <= 0:
    sync_us_per_op = 1
# Strictly detach worker before freeing shared handle (require_zero_workers=True default)
reader_ring.detach_shared_handle()
sh_ring.free_shared_handle()
nox.test.assert_true(sync_p50_us > 0 and sync_us_per_op > 0, "Non-zero microsecond p50 and us/op for cross_thread_shared_sync")

# ==============================================================================
# 5. Multi-Run Key-Count Scaling Benchmark (1 key, 16 keys, 64 keys x 5 runs x 1000 lookups)
# ==============================================================================
def _bench_key_scaling_median_us(target_keys: int) -> int:
    sc_ring: KeyRing = KeyRing(trust_domain="bench-scale")
    sc_ring.add_key(KeyRef("k-sc-0", "HS256", "super-secret-scaling-key-00000000", trust_domain="bench-scale", state=STATE_ACTIVE_SIGNING))
    idx: int = 1
    while idx < target_keys:
        sc_ring.add_key(KeyRef("k-sc-" + str(idx), "HS256", "super-secret-scaling-key-00000000", trust_domain="bench-scale", state=STATE_VERIFY_ONLY, activated_at=1000, retire_at=999999))
        idx = idx + 1
    last_kid: str = "k-sc-" + str(target_keys - 1)
    run_samples: list[int] = []
    r_i: int = 0
    while r_i < 5:
        st_inst: nox.time.Instant = nox.time.instant_now()
        q: int = 0
        while q < 1000:
            _vk: KeyRef = sc_ring.get_verification_key(last_kid, 2000)
            q = q + 1
        run_samples.append(_ms_to_nonzero_us(st_inst.elapsed_ms()))
        r_i = r_i + 1
    sorted_runs: list[int] = _sort_ints(run_samples)
    return _percentile(sorted_runs, 50)

scale_1_us: int = _bench_key_scaling_median_us(1)
scale_16_us: int = _bench_key_scaling_median_us(16)
scale_64_us: int = _bench_key_scaling_median_us(64)

# ==============================================================================
