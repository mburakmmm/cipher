bench_json: str = "{\n"
bench_json = bench_json + "  \"suite\": \"cipher_keyring_benchmark\",\n"
bench_json = bench_json + "  \"version\": \"1.0.11\",\n"
bench_json = bench_json + "  \"runs\": 5,\n"
bench_json = bench_json + "  \"metrics\": {\n"
bench_json = bench_json + "    \"seqlock_get_signing_key_5x1000_median_us\": " + str(sign_median_us) + ",\n"
bench_json = bench_json + "    \"seqlock_get_signing_key_p50_us\": " + str(sign_p50_us) + ",\n"
bench_json = bench_json + "    \"seqlock_get_signing_key_p95_us\": " + str(sign_p95_us) + ",\n"
bench_json = bench_json + "    \"seqlock_get_signing_key_ns_per_op\": " + str(sign_ns_per_op) + ",\n"
bench_json = bench_json + "    \"seqlock_get_verification_key_5x1000_median_us\": " + str(ver_median_us) + ",\n"
bench_json = bench_json + "    \"seqlock_get_verification_key_p50_us\": " + str(ver_p50_us) + ",\n"
bench_json = bench_json + "    \"seqlock_get_verification_key_p95_us\": " + str(ver_p95_us) + ",\n"
bench_json = bench_json + "    \"seqlock_get_verification_key_ns_per_op\": " + str(ver_ns_per_op) + ",\n"
bench_json = bench_json + "    \"atomic_rotate_5x20_median_us\": " + str(rot_median_us) + ",\n"
bench_json = bench_json + "    \"atomic_rotate_p50_us\": " + str(rot_p50_us) + ",\n"
bench_json = bench_json + "    \"atomic_rotate_p95_us\": " + str(rot_p95_us) + ",\n"
bench_json = bench_json + "    \"atomic_rotate_us_per_op\": " + str(rot_us_per_op) + ",\n"
bench_json = bench_json + "    \"cross_thread_shared_sync_5x10_median_us\": " + str(sync_median_us) + ",\n"
bench_json = bench_json + "    \"cross_thread_shared_sync_p50_us\": " + str(sync_p50_us) + ",\n"
bench_json = bench_json + "    \"cross_thread_shared_sync_p95_us\": " + str(sync_p95_us) + ",\n"
bench_json = bench_json + "    \"cross_thread_shared_sync_us_per_op\": " + str(sync_us_per_op) + ",\n"
bench_json = bench_json + "    \"scaling_1000_verify_1_key_median_us\": " + str(scale_1_us) + ",\n"
bench_json = bench_json + "    \"scaling_1000_verify_16_keys_median_us\": " + str(scale_16_us) + ",\n"
bench_json = bench_json + "    \"scaling_1000_verify_64_keys_median_us\": " + str(scale_64_us) + "\n"
bench_json = bench_json + "  }\n"
bench_json = bench_json + "}\n"
nox.fs.write_string("benchmark-results.json", bench_json)
nox.test.assert_true(nox.fs.exists("benchmark-results.json"), "benchmark-results.json artifact written")

def _fmt_delta_unit(curr: int, base: int, unit: str) -> str:
    diff: int = curr - base
    if diff > 0:
        return "+" + str(diff) + " " + unit
    return str(diff) + " " + unit

def _cmp_row_unit(name: str, base_v: int, curr_v: int, unit: str) -> str:
    return "| `" + name + "` | " + str(base_v) + " " + unit + " | " + str(curr_v) + " " + unit + " | " + _fmt_delta_unit(curr_v, base_v, unit) + " |\n"

nox.test.assert_true(nox.fs.exists("docs/benchmark-baseline.json"), "docs/benchmark-baseline.json exists")
base_raw: str = nox.fs.read_to_string("docs/benchmark-baseline.json")
base_doc: JsonValue = parse_strict_json(base_raw)
base_ver: str = get_string_field(base_doc, "version")
bm: JsonValue = get_field_value(base_doc, "metrics")

cmp_md: str = "## Cipher KeyRing Multi-Run Median Benchmark Comparison (`v" + base_ver + "` vs `v1.0.11`, 5-Run Median)\n\n"
cmp_md = cmp_md + "| Benchmark Metric (5-Run Median) | Baseline (`v" + base_ver + "`) | Current (`v1.0.11`) | Delta |\n"
cmp_md = cmp_md + "|---|---:|---:|---:|\n"
cmp_md = cmp_md + _cmp_row_unit("seqlock_get_signing_key_5x1000_median_us", get_int_field(bm, "seqlock_get_signing_key_5x1000_median_us"), sign_median_us, "us")
cmp_md = cmp_md + _cmp_row_unit("seqlock_get_signing_key_p50_us", get_int_field(bm, "seqlock_get_signing_key_p50_us"), sign_p50_us, "us")
cmp_md = cmp_md + _cmp_row_unit("seqlock_get_signing_key_p95_us", get_int_field(bm, "seqlock_get_signing_key_p95_us"), sign_p95_us, "us")
cmp_md = cmp_md + _cmp_row_unit("seqlock_get_signing_key_ns_per_op", get_int_field(bm, "seqlock_get_signing_key_ns_per_op"), sign_ns_per_op, "ns/op")
cmp_md = cmp_md + _cmp_row_unit("seqlock_get_verification_key_5x1000_median_us", get_int_field(bm, "seqlock_get_verification_key_5x1000_median_us"), ver_median_us, "us")
cmp_md = cmp_md + _cmp_row_unit("seqlock_get_verification_key_p50_us", get_int_field(bm, "seqlock_get_verification_key_p50_us"), ver_p50_us, "us")
cmp_md = cmp_md + _cmp_row_unit("seqlock_get_verification_key_p95_us", get_int_field(bm, "seqlock_get_verification_key_p95_us"), ver_p95_us, "us")
cmp_md = cmp_md + _cmp_row_unit("seqlock_get_verification_key_ns_per_op", get_int_field(bm, "seqlock_get_verification_key_ns_per_op"), ver_ns_per_op, "ns/op")
cmp_md = cmp_md + _cmp_row_unit("atomic_rotate_5x20_median_us", get_int_field(bm, "atomic_rotate_5x20_median_us"), rot_median_us, "us")
cmp_md = cmp_md + _cmp_row_unit("atomic_rotate_p50_us", get_int_field(bm, "atomic_rotate_p50_us"), rot_p50_us, "us")
cmp_md = cmp_md + _cmp_row_unit("atomic_rotate_p95_us", get_int_field(bm, "atomic_rotate_p95_us"), rot_p95_us, "us")
cmp_md = cmp_md + _cmp_row_unit("atomic_rotate_us_per_op", get_int_field(bm, "atomic_rotate_us_per_op"), rot_us_per_op, "us/op")
cmp_md = cmp_md + _cmp_row_unit("cross_thread_shared_sync_5x10_median_us", get_int_field(bm, "cross_thread_shared_sync_5x10_median_us"), sync_median_us, "us")
cmp_md = cmp_md + _cmp_row_unit("cross_thread_shared_sync_p50_us", get_int_field(bm, "cross_thread_shared_sync_p50_us"), sync_p50_us, "us")
cmp_md = cmp_md + _cmp_row_unit("cross_thread_shared_sync_p95_us", get_int_field(bm, "cross_thread_shared_sync_p95_us"), sync_p95_us, "us")
cmp_md = cmp_md + _cmp_row_unit("cross_thread_shared_sync_us_per_op", get_int_field(bm, "cross_thread_shared_sync_us_per_op"), sync_us_per_op, "us/op")
cmp_md = cmp_md + _cmp_row_unit("scaling_1000_verify_1_key_median_us", get_int_field(bm, "scaling_1000_verify_1_key_median_us"), scale_1_us, "us")
cmp_md = cmp_md + _cmp_row_unit("scaling_1000_verify_16_keys_median_us", get_int_field(bm, "scaling_1000_verify_16_keys_median_us"), scale_16_us, "us")
cmp_md = cmp_md + _cmp_row_unit("scaling_1000_verify_64_keys_median_us", get_int_field(bm, "scaling_1000_verify_64_keys_median_us"), scale_64_us, "us")
nox.fs.write_string("benchmark-comparison.md", cmp_md)
nox.test.assert_true(nox.fs.exists("benchmark-comparison.md"), "benchmark-comparison.md artifact written")

print("benchmark_keyring_test passed! (sign_p50=" + str(sign_p50_us) + "us, rot_p50=" + str(rot_p50_us) + "us, sync_p50=" + str(sync_p50_us) + "us, scale_64k=" + str(scale_64_us) + "us)")
