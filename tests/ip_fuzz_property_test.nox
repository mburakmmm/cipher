def _assert_malformed_rejected(bad: str) -> None:
    v4_rejected: bool = False
    try:
        _p4: IPv4Address = parse_ipv4(bad)
    except EncodingError:
        v4_rejected = True
    if not v4_rejected:
        raise Exception("Property 4 failure: parse_ipv4 accepted malformed input: " + bad)

    v6_rejected: bool = False
    try:
        _p6: IPv6Address = parse_ipv6(bad)
    except EncodingError:
        v6_rejected = True
    if not v6_rejected:
        raise Exception("Property 4 failure: parse_ipv6 accepted malformed input: " + bad)

    if verify_resolved_ip(bad):
        raise Exception("Property 4 failure: verify_resolved_ip accepted malformed input: " + bad)

m_idx: int = 0
while m_idx < len(malformed_inputs):
    _assert_malformed_rejected(malformed_inputs[m_idx])
    m_idx = m_idx + 1

# Programmatic fuzzing of synthetic corruptions around valid public IPs
base_octets: list[int] = [256, 257, 512, 1000, 65536, -1, -255]
b_idx: int = 0
while b_idx < len(base_octets):
    bad_oct: str = str(base_octets[b_idx])
    c1: str = bad_oct + ".8.8.8"
    c2: str = "8." + bad_oct + ".8.8"
    c3: str = "8.8." + bad_oct + ".8"
    c4: str = "8.8.8." + bad_oct
    c5: str = "::ffff:" + c1
    c6: str = "::ffff:" + c4
    _assert_malformed_rejected(c1)
    _assert_malformed_rejected(c2)
    _assert_malformed_rejected(c3)
    _assert_malformed_rejected(c4)
    _assert_malformed_rejected(c5)
    _assert_malformed_rejected(c6)
    b_idx = b_idx + 1

print("ip_fuzz_property_test passed!")
