import nox.test
from errors import ExpiredTokenError, InvalidClaimsError, InvalidSignatureError, MalformedTokenError, UnknownKeyError
from keys import KeyRef
from keyring import KeyRing
from signed_token import SignedTokenIssuer, SignedTokenVerifier, issue_signed_token, verify_signed_token

secret: str = "opaque-token-signing-key-minimum-32-bytes-long"
payload: str = "user_id=12345&action=reset_password"
purpose: str = "password_reset"

# 1. Issue and verify
token: str = issue_signed_token(payload, purpose, secret, ttl_seconds=300)
verified_payload: str = verify_signed_token(token, purpose, secret)
nox.test.assert_eq_str(verified_payload, payload, "Verified payload matches original")

# 2. Negative: Purpose mismatch rejection
wrong_purpose_failed: bool = False
try:
    verify_signed_token(token, "email_verification", secret)
except InvalidClaimsError:
    wrong_purpose_failed = True
nox.test.assert_true(wrong_purpose_failed, "Purpose mismatch must be rejected with InvalidClaimsError")

# 3. Negative: Expired token rejection
expired_failed: bool = False
try:
    # Clock injected into far future
    verify_signed_token(token, purpose, secret, clock_time_sec=2500000000)
except ExpiredTokenError:
    expired_failed = True
nox.test.assert_true(expired_failed, "Expired signed token must be rejected with ExpiredTokenError")

# 4. Negative: Tampered signature rejection
tampered_token: str = token + "corrupt"
tamper_failed: bool = False
try:
    verify_signed_token(tampered_token, purpose, secret)
except InvalidSignatureError:
    tamper_failed = True
nox.test.assert_true(tamper_failed, "Tampered signature rejected with InvalidSignatureError")

# 5. Negative: Invalid token prefix or format
prefix_failed: bool = False
try:
    verify_signed_token("jwt.like.token", purpose, secret)
except MalformedTokenError:
    prefix_failed = True
nox.test.assert_true(prefix_failed, "Malformed signed token prefix rejected with MalformedTokenError")

# 6. Negative: Future issued_at rejected
verifier: SignedTokenVerifier = SignedTokenVerifier()
# Verify with clock in the past (1000s before issuance)
future_iat_failed: bool = False
try:
    verifier.verify(token, purpose, secret, clock_time_sec=1000000000, leeway_seconds=30)
except InvalidClaimsError:
    future_iat_failed = True
nox.test.assert_true(future_iat_failed, "Future issued_at token must be rejected with InvalidClaimsError")

# 7. Negative: Max TTL exceeded
max_ttl_failed: bool = False
try:
    # token was issued with ttl=300; verify requiring max_ttl_seconds=60
    verifier.verify(token, purpose, secret, max_ttl_seconds=60)
except InvalidClaimsError:
    max_ttl_failed = True
nox.test.assert_true(max_ttl_failed, "Token exceeding max_ttl_seconds must be rejected")

# 8. Negative: Kid mismatch
kid_mismatch_failed: bool = False
try:
    verifier.verify(token, purpose, secret, expected_kid="other-key-id")
except UnknownKeyError:
    kid_mismatch_failed = True
nox.test.assert_true(kid_mismatch_failed, "Token with mismatched kid must be rejected with UnknownKeyError")

# 9. KeyRing Integration: verify_with_keyring
ring: KeyRing = KeyRing(trust_domain="default")
ring_key: KeyRef = KeyRef("key-ring-1", "HS256", "ring-secret-key-at-least-32-bytes-long", trust_domain="default", state="ACTIVE_SIGNING")
ring.add_key(ring_key)

ring_issuer: SignedTokenIssuer = SignedTokenIssuer()
ring_token: str = ring_issuer.issue("session_data=secure", "session", ring_key.secret_material, ttl_seconds=600, kid="key-ring-1")

ring_verified: str = verifier.verify_with_keyring(ring_token, "session", ring)
nox.test.assert_eq_str(ring_verified, "session_data=secure", "KeyRing verified signed token payload matches")
