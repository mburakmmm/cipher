# Cipher — KeyRing & Safe Key Lifecycle Management
# Enforces trust domain isolation, unique kid indexing, zero dual-active signers,
# length-prefixed canonical SHA-256 + HMAC-SHA256 tamper-evident sealing,
# hardware Acquire-Release Seqlock coherent reads, explicit commit linearization,
# and cross-OS-thread shared atomic state synchronization.

import nox.atomic
import nox.crypto
import nox.strings
import nox.time
from cipher.errors import AmbiguousKeyError, ConfigurationError, KeyUnavailableError, UnknownKeyError
from cipher.keys import KeyRef, STATE_ACTIVE_SIGNING, STATE_PREPARED, STATE_RETIRED, STATE_REVOKED, STATE_VERIFY_ONLY
from cipher.rotation import RotationReceipt

SHARED_ATOMIC_WORDS: int = 512      # Default 512 * 6 = 3072 bytes cross-thread shared atomic state capacity
SHARED_KEY_WORDS: int = 11          # 11 * 6 = 66 bytes capacity for 64-byte hex HMAC seal key
MAX_SEQLOCK_ATTEMPTS: int = 2000000 # High spin ceiling for OS thread preemption resilience

# Single-word 64-bit _shared_gate bitfield layout:
# - Bits 0..29  (SHARED_READER_MASK): active in-flight reader count (0 .. 1,073,741,823)
# - Bit  30     (SHARED_CLOSING_BIT): 1 when CLOSING/DRAINING (atomically blocks new readers & workers via CAS)
# - Bits 32..61 (SHARED_WORKER_UNIT): attached worker KeyRing count (0 .. 1,073,741,823)
SHARED_READER_MASK: int = 1073741823
SHARED_CLOSING_BIT: int = 1073741824
SHARED_WORKER_UNIT: int = 4294967296

# Explicit shared handle lifecycle states
SHARED_STATE_UNSHARED: str = "UNSHARED"
SHARED_STATE_ALIVE: str = "ALIVE"
SHARED_STATE_CLOSING: str = "CLOSING"
SHARED_STATE_DRAINING: str = "DRAINING"
SHARED_STATE_DESTROYED: str = "DESTROYED"
SHARED_STATE_POISONED: str = "POISONED"

def redact_shared_handle(handle_str: str) -> str:
    if nox.strings.byte_len(handle_str) == 0:
        return "KeyRingSharedHandle([EMPTY])"
    return "KeyRingSharedHandle([REDACTED])"

def _pack_shared_words(canon: str, max_words: int) -> list[int]:
    n: int = nox.strings.byte_len(canon)
    max_bytes: int = max_words * 6
    if n > max_bytes:
        raise ConfigurationError("Shared atomic state capacity exceeded (" + str(n) + " > " + str(max_bytes) + " bytes)")
    words: list[int] = []
    pos: int = 0
    while pos < n:
        word: int = 0
        b_idx: int = 0
        while b_idx < 6 and (pos + b_idx) < n:
            b_val: int = nox.strings.byte_at(canon, pos + b_idx) & 255
            word = word | (b_val << (b_idx * 8))
            b_idx = b_idx + 1
        words.append(word)
        pos = pos + 6
    return words

def _unpack_shared_words(words: list[int], byte_len: int) -> str:
    out: str = ""
    w_idx: int = 0
    pos: int = 0
    n_words: int = len(words)
    while pos < byte_len and w_idx < n_words:
        word: int = words[w_idx]
        b_idx: int = 0
        while b_idx < 6 and (pos + b_idx) < byte_len:
            ch_code: int = (word >> (b_idx * 8)) & 255
            out = out + nox.strings.char_from_byte(ch_code)
            b_idx = b_idx + 1
        w_idx = w_idx + 1
        pos = pos + 6
    return out

def _lp(val: str) -> str:
    return str(nox.strings.byte_len(val)) + "#" + val

def _serialize_state_canonical(version: int, keys: list[KeyRef], created_at: int) -> str:
    # Unambiguous prefix-free UTF-8 byte-length-prefixed canonical serialization (<decimal_byte_len>#<exact_utf8_bytes>).
    # Immune to delimiter injection (':', '|', '#') and multi-byte UTF-8 length skew across all KeyRef fields.
    raw: str = "CIPHER-KR-CANON-V2#" + _lp(str(version)) + _lp(str(created_at)) + _lp(str(len(keys)))
    i: int = 0
    n: int = len(keys)
    while i < n:
        k: KeyRef = keys[i]
        raw = raw + _lp(k.kid) + _lp(k.algorithm) + _lp(k.secret_material) + _lp(k.trust_domain) + _lp(k.state) + _lp(str(k.activated_at)) + _lp(str(k.retire_at))
        i = i + 1
    return raw

def _compute_state_seal(version: int, keys: list[KeyRef], created_at: int) -> str:
    return nox.crypto.sha256(_serialize_state_canonical(version, keys, created_at))

class _CanonCursor:
    raw: str
    pos: int
    n: int

    def __init__(self, raw: str, start_pos: int) -> None:
        self.raw = raw
        self.pos = start_pos
        self.n = nox.strings.byte_len(raw)

    def next_str(self) -> str:
        if self.pos >= self.n:
            raise ConfigurationError("Canonical state deserialization error: unexpected end of stream")
        len_val: int = 0
        has_digits: bool = False
        while self.pos < self.n and nox.strings.byte_at(self.raw, self.pos) != 35:
            c: int = nox.strings.byte_at(self.raw, self.pos)
            if c < 48 or c > 57:
                raise ConfigurationError("Canonical state deserialization error: invalid length prefix")
            len_val = len_val * 10 + (c - 48)
            has_digits = True
            self.pos = self.pos + 1
        if not has_digits or self.pos >= self.n or nox.strings.byte_at(self.raw, self.pos) != 35:
            raise ConfigurationError("Canonical state deserialization error: missing '#' delimiter")
        self.pos = self.pos + 1
        if self.pos + len_val > self.n:
            raise ConfigurationError("Canonical state deserialization error: truncated field payload")
        out: str = ""
        i: int = 0
        while i < len_val:
            out = out + nox.strings.char_from_byte(nox.strings.byte_at(self.raw, self.pos + i))
            i = i + 1
        self.pos = self.pos + len_val
        return out

    def next_int(self) -> int:
        s: str = self.next_str()
        if len(s) == 0:
            raise ConfigurationError("Canonical state deserialization error: empty integer token")
        val: int = 0
        idx: int = 0
        neg: bool = False
        if s[0] == "-":
            neg = True
            idx = 1
            if len(s) == 1:
                raise ConfigurationError("Canonical state deserialization error: invalid negative integer")
        while idx < len(s):
            c: int = ord(s[idx])
            if c < 48 or c > 57:
                raise ConfigurationError("Canonical state deserialization error: non-digit in integer token")
            val = val * 10 + (c - 48)
            idx = idx + 1
        if neg:
            return -val
        return val

class KeyRingState:
    version: int
    _keys: list[KeyRef]
    created_at: int
    _integrity_hash: str

    def __init__(self, version: int, keys: list[KeyRef], created_at: int = 0) -> None:
        self.version = version
        # Deep defensive clone on construction: caller cannot retain mutable handle to internal list or KeyRefs
        cloned: list[KeyRef] = []
        i: int = 0
        n: int = len(keys)
        while i < n:
            cloned.append(keys[i].clone())
            i = i + 1
        self._keys = cloned
        self.created_at = created_at
        self._integrity_hash = _compute_state_seal(self.version, self._keys, self.created_at)

    def get_seal_hash(self) -> str:
        return self._integrity_hash

    def verify_integrity(self) -> None:
        expected: str = _compute_state_seal(self.version, self._keys, self.created_at)
        if not nox.crypto.constant_time_eq(expected, self._integrity_hash):
            raise ConfigurationError("KeyRingState integrity violation: unauthorized direct field mutation detected")

    def get_keys(self) -> list[KeyRef]:
        self.verify_integrity()
        # Return deep defensive clone on every inspection: external mutations never corrupt snapshot
        snap: list[KeyRef] = []
        i: int = 0
        n: int = len(self._keys)
        while i < n:
            snap.append(self._keys[i].clone())
            i = i + 1
        return snap

    def key_count(self) -> int:
        self.verify_integrity()
        return len(self._keys)

def _deserialize_state_canonical(raw: str) -> KeyRingState:
    if not nox.strings.starts_with(raw, "CIPHER-KR-CANON-V2#"):
        raise ConfigurationError("Canonical state deserialization error: invalid header")
    cur: _CanonCursor = _CanonCursor(raw, 19)
    ver: int = cur.next_int()
    created_at: int = cur.next_int()
    k_count: int = cur.next_int()
    if k_count < 0 or k_count > 1024:
        raise ConfigurationError("Canonical state deserialization error: invalid key count")
    k_list: list[KeyRef] = []
    i: int = 0
    while i < k_count:
        kid: str = cur.next_str()
        alg: str = cur.next_str()
        sec: str = cur.next_str()
        dom: str = cur.next_str()
        st_str: str = cur.next_str()
        act_at: int = cur.next_int()
        ret_at: int = cur.next_int()
        kr: KeyRef = KeyRef(kid, alg, sec, trust_domain=dom, state=st_str, activated_at=act_at, retire_at=ret_at)
        k_list.append(kr)
        i = i + 1
    if cur.pos != cur.n:
        raise ConfigurationError("Canonical state deserialization error: trailing bytes in stream")
    res: KeyRingState = KeyRingState(ver, k_list, created_at)
    res.verify_integrity()
    return res

def _parse_handle_int(s: str) -> int:
    if len(s) == 0:
        raise ConfigurationError("Invalid empty atomic handle string")
    val: int = 0
    i: int = 0
    n: int = len(s)
    while i < n:
        c: int = ord(s[i])
        if c < 48 or c > 57:
            raise ConfigurationError("Non-digit character in atomic handle string")
        val = val * 10 + (c - 48)
        i = i + 1
    return val

class KeyRing:
    trust_domain: str
    _state: KeyRingState
    _seal_key: str
    _state_mac: str
    _write_lock: nox.atomic.AtomicBool
    _seq: nox.atomic.AtomicInt
    _atomic_version: nox.atomic.AtomicInt
    _shared_attached: bool
    _is_shared_owner: bool
    _shared_worker_registered: bool
    _zeroize_poisoned: bool
    _zeroize_fault_inject: bool
    _shared_lifecycle_local: str
    _shared_synced_seq: int
    _shared_alive: nox.atomic.AtomicBool
    _shared_gate: nox.atomic.AtomicInt
    _shared_readers: nox.atomic.AtomicInt
    _shared_len: nox.atomic.AtomicInt
    _shared_key_cells: list[nox.atomic.AtomicInt]
    _shared_cells: list[nox.atomic.AtomicInt]

    def __init__(self, trust_domain: str = "default") -> None:
        self.trust_domain = trust_domain
        initial_keys: list[KeyRef] = []
        self._state = KeyRingState(0, initial_keys, 0)
        self._write_lock = nox.atomic.new_bool(False)
        self._seq = nox.atomic.new_int(0)
        self._atomic_version = nox.atomic.new_int(0)
        # Per-KeyRing HMAC authentication key bound to unique runtime atomic cell addresses
        seed_material: str = "CIPHER-KR-HMAC-V2|" + trust_domain + "|" + str(self._write_lock.handle) + "|" + str(self._seq.handle) + "|" + str(self._atomic_version.handle)
        self._seal_key = nox.crypto.sha256(seed_material)
        self._state_mac = nox.crypto.hmac_sha256(self._seal_key, self._state.get_seal_hash())
        self._shared_attached = False
        self._is_shared_owner = False
        self._shared_worker_registered = False
        self._zeroize_poisoned = False
        self._zeroize_fault_inject = False
        self._shared_lifecycle_local = SHARED_STATE_UNSHARED
        self._shared_synced_seq = 0
        self._shared_alive = nox.atomic.from_bool_handle(0)
        self._shared_gate = nox.atomic.from_int_handle(0)
        self._shared_readers = self._shared_gate
        self._shared_len = nox.atomic.from_int_handle(0)
        empty_key_cells: list[nox.atomic.AtomicInt] = []
        self._shared_key_cells = empty_key_cells
        empty_cells: list[nox.atomic.AtomicInt] = []
        self._shared_cells = empty_cells

    def get_lock_handle(self) -> int:
        return self._write_lock.handle

    def get_seq_handle(self) -> int:
        return self._seq.handle

    def get_version_handle(self) -> int:
        return self._atomic_version.handle

    def bind_shared_atomics(self, lock_handle: int, seq_handle: int, ver_handle: int) -> None:
        self._write_lock = nox.atomic.from_bool_handle(lock_handle)
        self._seq = nox.atomic.from_int_handle(seq_handle)
        self._atomic_version = nox.atomic.from_int_handle(ver_handle)

    def _try_acquire_reader_gate(self) -> bool:
        # Single-word hardware CAS gate on _shared_gate (0.16.1):
        # Atomically verifies SHARED_CLOSING_BIT == 0 and increments active_readers (bits 0..29)
        # in the exact same 64-bit word. Once SHARED_CLOSING_BIT is set, reader registration is
        # atomically rejected without ever incrementing the reader count, closing the T1..T5 race.
        if not self._shared_attached:
            return False
        spins: int = 0
        while spins < MAX_SEQLOCK_ATTEMPTS:
            cur: int = self._shared_gate.add(0)
            if (cur & SHARED_CLOSING_BIT) != 0:
                return False
            if self._shared_gate.compare_and_swap(cur, cur + 1):
                return True
            spins = spins + 1
        return False

    def _release_reader_gate(self) -> None:
        if self._shared_attached:
            self._shared_gate.add(-1)

    def _write_shared_words(self, words: list[int], byte_len: int) -> None:
        w_idx: int = 0
        n_words: int = len(words)
        while w_idx < n_words:
            self._shared_cells[w_idx].store(words[w_idx])
            w_idx = w_idx + 1
        self._shared_len.store(byte_len)

    def _read_shared_words_raw(self, byte_len: int) -> list[int]:
        # Pure integer loads between s1 and s2: never throws on torn intermediate reads
        words: list[int] = []
        max_words: int = len(self._shared_cells)
        if byte_len <= 0 or byte_len > (max_words * 6):
            return words
        n_words: int = (byte_len + 5) // 6
        w_idx: int = 0
        while w_idx < n_words:
            words.append(self._shared_cells[w_idx].add(0))
            w_idx = w_idx + 1
        return words

    def get_shared_lifecycle_state(self) -> str:
        # Explicit lifecycle machine: UNSHARED -> ALIVE -> CLOSING -> DRAINING -> DESTROYED (or POISONED on zeroize fault)
        if self._zeroize_poisoned:
            return SHARED_STATE_POISONED
        if not self._shared_attached:
            return self._shared_lifecycle_local
        g_val: int = self._shared_gate.add(0)
        if (g_val & SHARED_CLOSING_BIT) != 0:
            if (self._seq.add(0) & 1) != 0 or self._shared_alive.load():
                return SHARED_STATE_CLOSING
            return SHARED_STATE_DRAINING
        if not self._shared_alive.load():
            return SHARED_STATE_DRAINING
        return SHARED_STATE_ALIVE

    def is_zeroize_poisoned(self) -> bool:
        return self._zeroize_poisoned

    def is_shared_owner(self) -> bool:
        return self._shared_attached and self._is_shared_owner

    def attached_shared_workers(self) -> int:
        if not self._shared_attached:
            return 0
        return (self._shared_gate.add(0) >> 32) & SHARED_READER_MASK

    def is_shared_alive(self) -> bool:
        if not self._shared_attached:
            return False
        if (self._shared_gate.add(0) & SHARED_CLOSING_BIT) != 0:
            return False
        return self._shared_alive.load()

    def is_shared_zeroized(self) -> bool:
        # Boolean-only diagnostic verification that never exposes raw cell values or key words.
        if not self._shared_attached:
            return True
        if self._shared_alive.load():
            return False
        if (self._shared_gate.add(0) & SHARED_CLOSING_BIT) == 0:
            return False
        if self._shared_len.load() != 0:
            return False
        i: int = 0
        while i < len(self._shared_cells):
            if self._shared_cells[i].load() != 0:
                return False
            i = i + 1
        k_i: int = 0
        while k_i < len(self._shared_key_cells):
            if self._shared_key_cells[k_i].load() != 0:
                return False
            k_i = k_i + 1
        return True

    def shared_capacity_bytes(self) -> int:
        if not self._shared_attached:
            return 0
        return len(self._shared_cells) * 6

    def shared_used_bytes(self) -> int:
        if not self.is_shared_alive():
            return 0
        return self._shared_len.add(0)

    def shared_usage_permille(self) -> int:
        cap: int = self.shared_capacity_bytes()
        if cap <= 0:
            return 0
        used: int = self.shared_used_bytes()
        if used <= 0:
            return 0
        return (used * 1000) // cap

    def export_shared_handle(self, max_words: int = 512) -> str:
        # Initializes process-wide shared atomic state cells so multiple OS threads
        # share the exact same KeyRingState under the Seqlock protocol.
        # SECURITY INVARIANT: The returned handle string contains ONLY numeric atomic handle IDs;
        # _seal_key is stored inside dedicated atomic memory cells (_shared_key_cells) and NEVER
        # serialized as plaintext into the handle string.
        if max_words < 64 or max_words > 8192:
            raise ConfigurationError("Shared atomic max_words must be between 64 and 8192")
        if self._shared_attached and not self._is_shared_owner:
            raise ConfigurationError("Worker KeyRing instance cannot export_shared_handle(); only owner may export")
        st: KeyRingState = self._read_consistent_state()
        if not self._shared_attached:
            self._shared_alive = nox.atomic.new_bool(True)
            self._shared_gate = nox.atomic.new_int(0)
            self._shared_readers = self._shared_gate
            self._shared_len = nox.atomic.new_int(0)
            key_cells: list[nox.atomic.AtomicInt] = []
            k_i: int = 0
            while k_i < SHARED_KEY_WORDS:
                key_cells.append(nox.atomic.new_int(0))
                k_i = k_i + 1
            packed_key: list[int] = _pack_shared_words(self._seal_key, SHARED_KEY_WORDS)
            pk_i: int = 0
            while pk_i < len(packed_key):
                key_cells[pk_i].store(packed_key[pk_i])
                pk_i = pk_i + 1
            self._shared_key_cells = key_cells

            cells: list[nox.atomic.AtomicInt] = []
            i: int = 0
            while i < max_words:
                cells.append(nox.atomic.new_int(0))
                i = i + 1
            self._shared_cells = cells
            canon: str = _serialize_state_canonical(st.version, st.get_keys(), st.created_at)
            packed: list[int] = _pack_shared_words(canon, len(self._shared_cells))
            self._write_shared_words(packed, nox.strings.byte_len(canon))
            self._shared_synced_seq = st.version * 2
            self._shared_attached = True
            self._is_shared_owner = True
            self._shared_worker_registered = False
            self._shared_lifecycle_local = SHARED_STATE_ALIVE

        key_parts: str = ""
        k_idx: int = 0
        while k_idx < len(self._shared_key_cells):
            if k_idx > 0:
                key_parts = key_parts + ","
            key_parts = key_parts + str(self._shared_key_cells[k_idx].handle)
            k_idx = k_idx + 1

        cell_parts: str = ""
        idx: int = 0
        while idx < len(self._shared_cells):
            if idx > 0:
                cell_parts = cell_parts + ","
            cell_parts = cell_parts + str(self._shared_cells[idx].handle)
            idx = idx + 1
        return str(self._write_lock.handle) + "|" + str(self._seq.handle) + "|" + str(self._atomic_version.handle) + "|" + str(self._shared_len.handle) + "|" + str(self._shared_alive.handle) + "|" + str(self._shared_gate.handle) + "|" + key_parts + "|" + cell_parts

    def attach_shared_handle(self, handle_str: str) -> None:
        if self._shared_attached and self._is_shared_owner:
            raise ConfigurationError("Cannot attach_shared_handle on an owning KeyRing instance")
        parts: list[str] = nox.strings.split(handle_str, "|")
        if len(parts) != 8:
            raise ConfigurationError("Invalid shared KeyRing handle format")
        lock_h: int = _parse_handle_int(parts[0])
        seq_h: int = _parse_handle_int(parts[1])
        ver_h: int = _parse_handle_int(parts[2])
        len_h: int = _parse_handle_int(parts[3])
        alive_h: int = _parse_handle_int(parts[4])
        gate_h: int = _parse_handle_int(parts[5])
        if lock_h <= 0 or seq_h <= 0 or ver_h <= 0 or len_h <= 0 or alive_h <= 0 or gate_h <= 0:
            raise ConfigurationError("Invalid zero or negative atomic handle identifier")
        key_cell_strs: list[str] = nox.strings.split(parts[6], ",")
        if len(key_cell_strs) != SHARED_KEY_WORDS:
            raise ConfigurationError("Invalid shared key cell handle count")
        cell_strs: list[str] = nox.strings.split(parts[7], ",")
        if len(cell_strs) < 64 or len(cell_strs) > 8192:
            raise ConfigurationError("Invalid shared data cell handle count")

        # Validate all integer handles before touching any state on self
        key_h_list: list[int] = []
        kh_i: int = 0
        while kh_i < len(key_cell_strs):
            kh_val: int = _parse_handle_int(key_cell_strs[kh_i])
            if kh_val <= 0:
                raise ConfigurationError("Invalid shared key cell handle identifier")
            key_h_list.append(kh_val)
            kh_i = kh_i + 1

        cell_h_list: list[int] = []
        ch_i: int = 0
        while ch_i < len(cell_strs):
            ch_val: int = _parse_handle_int(cell_strs[ch_i])
            if ch_val <= 0:
                raise ConfigurationError("Invalid shared data cell handle identifier")
            cell_h_list.append(ch_val)
            ch_i = ch_i + 1

        gate_atom: nox.atomic.AtomicInt = nox.atomic.from_int_handle(gate_h)
        # Single-word CAS gate acquisition: atomically verify SHARED_CLOSING_BIT == 0
        # and register 1 attached worker (SHARED_WORKER_UNIT) + 1 in-flight reader (+1)
        # before reading any other shared atomic cell!
        gate_acquired: bool = False
        g_spins: int = 0
        while g_spins < MAX_SEQLOCK_ATTEMPTS:
            g_cur: int = gate_atom.add(0)
            if (g_cur & SHARED_CLOSING_BIT) != 0:
                raise ConfigurationError("Shared KeyRing handle has been zeroized or destroyed")
            if gate_atom.compare_and_swap(g_cur, g_cur + SHARED_WORKER_UNIT + 1):
                gate_acquired = True
                break
            g_spins = g_spins + 1
        if not gate_acquired:
            raise ConfigurationError("Shared KeyRing gate contention timeout during attach_shared_handle")

        old_lock: nox.atomic.AtomicBool = self._write_lock
        old_seq: nox.atomic.AtomicInt = self._seq
        old_ver: nox.atomic.AtomicInt = self._atomic_version
        old_len: nox.atomic.AtomicInt = self._shared_len
        old_alive: nox.atomic.AtomicBool = self._shared_alive
        old_gate: nox.atomic.AtomicInt = self._shared_gate
        old_key_cells: list[nox.atomic.AtomicInt] = self._shared_key_cells
        old_seal_key: str = self._seal_key
        old_cells: list[nox.atomic.AtomicInt] = self._shared_cells
        old_synced_seq: int = self._shared_synced_seq
        old_attached: bool = self._shared_attached
        old_owner: bool = self._is_shared_owner
        old_worker_reg: bool = self._shared_worker_registered
        old_lifecycle: str = self._shared_lifecycle_local

        try:
            alive_atom: nox.atomic.AtomicBool = nox.atomic.from_bool_handle(alive_h)
            if not alive_atom.load():
                raise ConfigurationError("Shared KeyRing handle has been zeroized or destroyed")

            key_cells: list[nox.atomic.AtomicInt] = []
            k_i: int = 0
            key_words: list[int] = []
            while k_i < len(key_h_list):
                kc: nox.atomic.AtomicInt = nox.atomic.from_int_handle(key_h_list[k_i])
                key_cells.append(kc)
                key_words.append(kc.add(0))
                k_i = k_i + 1
            seal_k: str = _unpack_shared_words(key_words, 64)
            if nox.strings.byte_len(seal_k) != 64:
                raise ConfigurationError("Invalid shared KeyRing seal key length")

            cells: list[nox.atomic.AtomicInt] = []
            i: int = 0
            while i < len(cell_h_list):
                cells.append(nox.atomic.from_int_handle(cell_h_list[i]))
                i = i + 1

            self._write_lock = nox.atomic.from_bool_handle(lock_h)
            self._seq = nox.atomic.from_int_handle(seq_h)
            self._atomic_version = nox.atomic.from_int_handle(ver_h)
            self._shared_len = nox.atomic.from_int_handle(len_h)
            self._shared_alive = alive_atom
            self._shared_gate = gate_atom
            self._shared_readers = gate_atom
            self._shared_key_cells = key_cells
            self._seal_key = seal_k
            self._shared_cells = cells
            self._shared_synced_seq = -1
            self._shared_attached = True
            self._is_shared_owner = False
            self._shared_worker_registered = True
            self._shared_lifecycle_local = SHARED_STATE_ALIVE
            # Synchronize local snapshot while holding the +1 reader slot in _shared_gate
            _synced: KeyRingState = self._read_consistent_state_inner()
        except Exception as err:
            self._write_lock = old_lock
            self._seq = old_seq
            self._atomic_version = old_ver
            self._shared_len = old_len
            self._shared_alive = old_alive
            self._shared_gate = old_gate
            self._shared_readers = old_gate
            self._shared_key_cells = old_key_cells
            self._seal_key = old_seal_key
            self._shared_cells = old_cells
            self._shared_synced_seq = old_synced_seq
            self._shared_attached = old_attached
            self._is_shared_owner = old_owner
            self._shared_worker_registered = old_worker_reg
            self._shared_lifecycle_local = old_lifecycle
            gate_atom.add(-(SHARED_WORKER_UNIT + 1))
            raise ConfigurationError(str(err))

        if old_attached and old_worker_reg and old_gate.handle > 0 and old_gate.handle != gate_h:
            old_gate.add(-SHARED_WORKER_UNIT)
        # Release temporary +1 reader slot, retaining +SHARED_WORKER_UNIT for attached worker lifecycle
        self._shared_gate.add(-1)

    def detach_shared_handle(self) -> None:
        if not self._shared_attached:
            return
        if self._is_shared_owner:
            raise ConfigurationError("Owning KeyRing instance cannot call detach_shared_handle(); use free_shared_handle() instead")
        if self._shared_worker_registered:
            spins: int = 0
            cas_detached: bool = False
            while spins < MAX_SEQLOCK_ATTEMPTS:
                cur: int = self._shared_gate.add(0)
                workers: int = (cur >> 32) & SHARED_READER_MASK
                if workers <= 0:
                    break
                if self._shared_gate.compare_and_swap(cur, cur - SHARED_WORKER_UNIT):
                    cas_detached = True
                    break
                spins = spins + 1
            if not cas_detached:
                raise ConfigurationError("Failed to detach shared KeyRing worker: atomic gate CAS contention or invalid worker count")
            self._shared_worker_registered = False
        cur_ver: int = self._state.version
        self._write_lock = nox.atomic.new_bool(False)
        self._seq = nox.atomic.new_int(cur_ver * 2)
        self._atomic_version = nox.atomic.new_int(cur_ver)
        seed_material: str = "CIPHER-KR-HMAC-V2|" + self.trust_domain + "|" + str(self._write_lock.handle) + "|" + str(self._seq.handle) + "|" + str(self._atomic_version.handle)
        self._seal_key = nox.crypto.sha256(seed_material)
        self._state_mac = nox.crypto.hmac_sha256(self._seal_key, self._state.get_seal_hash())
        self._shared_attached = False
        self._is_shared_owner = False
        self._shared_lifecycle_local = SHARED_STATE_UNSHARED
        self._shared_synced_seq = cur_ver * 2
        self._shared_alive = nox.atomic.from_bool_handle(0)
        self._shared_gate = nox.atomic.from_int_handle(0)
        self._shared_readers = self._shared_gate
        self._shared_len = nox.atomic.from_int_handle(0)
        empty_key_cells: list[nox.atomic.AtomicInt] = []
        self._shared_key_cells = empty_key_cells
        empty_cells: list[nox.atomic.AtomicInt] = []
        self._shared_cells = empty_cells

    def begin_closing_shared_state(self) -> None:
        # Transitions the shared handle from ALIVE -> CLOSING by atomically setting
        # SHARED_CLOSING_BIT on _shared_gate via CAS. Once set, all new reader registrations
        # (_try_acquire_reader_gate) and new worker attachments (attach_shared_handle)
        # are immediately rejected at the hardware CAS gate.
        if not self._shared_attached:
            return
        if not self._is_shared_owner:
            raise ConfigurationError("Only the owning KeyRing instance may close the shared handle")
        gate_spins: int = 0
        gate_closed: bool = False
        while gate_spins < MAX_SEQLOCK_ATTEMPTS:
            g_cur: int = self._shared_gate.add(0)
            if (g_cur & SHARED_CLOSING_BIT) != 0:
                gate_closed = True
                break
            if self._shared_gate.compare_and_swap(g_cur, g_cur | SHARED_CLOSING_BIT):
                gate_closed = True
                break
            gate_spins = gate_spins + 1
        if not gate_closed:
            raise ConfigurationError("Shared KeyRing gate contention timeout while setting SHARED_CLOSING_BIT")
        self._shared_lifecycle_local = SHARED_STATE_CLOSING

    def zeroize_shared_state(self) -> None:
        # Strictly requires acquiring the hardware writer lock (_write_lock) before
        # modifying any shared cell. If another writer holds the lock and it cannot
        # be acquired within the bounded spin window, fails closed with ConfigurationError
        # without touching a single shared cell!
        # Critical section is wrapped in try/except (0.16.4 & 0.17.3) so _write_lock is ALWAYS
        # released, Seqlock is restored to an even value, and on any mid-zeroization error
        # the KeyRing is permanently marked SHARED_STATE_POISONED and can never be reused.
        if not self._shared_attached:
            return
        if not self._is_shared_owner:
            raise ConfigurationError("Only the owning KeyRing instance may call zeroize_shared_state()")
        spins: int = 0
        locked: bool = False
        while spins < 4096:
            if self._write_lock.compare_and_swap(False, True):
                locked = True
                break
            spins = spins + 1
        if not locked:
            raise ConfigurationError("Zeroization contention error: cannot zeroize shared state while writer lock is held")

        seq_odd_entered: bool = False
        try:
            # 1. Atomically set SHARED_CLOSING_BIT on single-word _shared_gate via CAS (ALIVE -> CLOSING)
            gate_spins: int = 0
            gate_closed: bool = False
            while gate_spins < MAX_SEQLOCK_ATTEMPTS:
                g_cur: int = self._shared_gate.add(0)
                if (g_cur & SHARED_CLOSING_BIT) != 0:
                    gate_closed = True
                    break
                if self._shared_gate.compare_and_swap(g_cur, g_cur | SHARED_CLOSING_BIT):
                    gate_closed = True
                    break
                gate_spins = gate_spins + 1
            if not gate_closed:
                raise ConfigurationError("Zeroization gate contention timeout on _shared_gate")
            self._shared_lifecycle_local = SHARED_STATE_CLOSING

            # 2. Enter Seqlock odd write phase with Acquire-Release RMW fence
            cur_seq: int = self._seq.add(0)
            if (cur_seq & 1) == 0:
                self._seq.add(1)
                seq_odd_entered = True

            # 3. Overwrite shared length, data cells, and HMAC key cells with zeros
            self._shared_alive.store(False)
            self._shared_len.store(0)
            i: int = 0
            while i < len(self._shared_cells):
                self._shared_cells[i].store(0)
                if i == 0 and self._zeroize_fault_inject:
                    raise ConfigurationError("Simulated mid-zeroization fault after partial cell scrub")
                i = i + 1
            k_i: int = 0
            while k_i < len(self._shared_key_cells):
                self._shared_key_cells[k_i].store(0)
                k_i = k_i + 1
            empty_keys: list[KeyRef] = []
            self._state = KeyRingState(0, empty_keys, 0)
            self._seal_key = ""
            self._state_mac = ""

            # 4. Seal Seqlock to next even value and transition to DRAINING
            if seq_odd_entered:
                self._seq.add(1)
                seq_odd_entered = False
            self._shared_lifecycle_local = SHARED_STATE_DRAINING
        except Exception as err:
            # Permanently poison this KeyRing instance so a partially zeroed state can NEVER be reused (0.17.3)
            self._zeroize_poisoned = True
            self._shared_lifecycle_local = SHARED_STATE_POISONED
            self._shared_alive.store(False)
            empty_p_keys: list[KeyRef] = []
            self._state = KeyRingState(0, empty_p_keys, 0)
            self._seal_key = ""
            self._state_mac = ""
            if seq_odd_entered:
                self._seq.add(1)
            self._write_lock.store(False)
            raise ConfigurationError(str(err))

        self._write_lock.store(False)

    def active_shared_readers(self) -> int:
        if not self._shared_attached:
            return 0
        return self._shared_gate.add(0) & SHARED_READER_MASK

    def free_shared_handle(self, require_zero_workers: bool = True) -> None:
        if self._shared_attached:
            if not self._is_shared_owner:
                raise ConfigurationError("Only the owning KeyRing instance may call free_shared_handle(); worker instances must call detach_shared_handle()")
            if require_zero_workers:
                w_spins: int = 0
                while self.attached_shared_workers() > 0 and w_spins < 4096:
                    w_spins = w_spins + 1
                if self.attached_shared_workers() > 0:
                    raise ConfigurationError("Cannot free shared KeyRing handle while worker instances are still attached")
            if not self._zeroize_poisoned and (self._shared_alive.load() or (self._shared_gate.add(0) & SHARED_CLOSING_BIT) == 0):
                self.zeroize_shared_state()
            if require_zero_workers and self.attached_shared_workers() > 0:
                raise ConfigurationError("Cannot free shared KeyRing handle while worker instances are still attached")
            # Drain all active concurrent readers via single-word _shared_gate before deallocating cells.
            # Because SHARED_CLOSING_BIT is set in _shared_gate, no new reader can ever increment
            # the low 30 bits; once (gate & SHARED_READER_MASK) reaches 0, it remains 0 permanently.
            drain_spins: int = 0
            while (self._shared_gate.add(0) & SHARED_READER_MASK) > 0 and drain_spins < 4096:
                drain_spins = drain_spins + 1
            if (self._shared_gate.add(0) & SHARED_READER_MASK) > 0:
                raise ConfigurationError("Cannot free shared KeyRing handle while active readers are in flight")
            i: int = 0
            while i < len(self._shared_cells):
                self._shared_cells[i].free()
                i = i + 1
            k_i: int = 0
            while k_i < len(self._shared_key_cells):
                self._shared_key_cells[k_i].free()
                k_i = k_i + 1
            self._shared_len.free()
            self._shared_alive.free()
            self._shared_gate.free()
            self._shared_attached = False
            self._is_shared_owner = False
            self._shared_worker_registered = False
            if not self._zeroize_poisoned:
                self._shared_lifecycle_local = SHARED_STATE_DESTROYED

    def _read_consistent_state_inner(self) -> KeyRingState:
        if self._zeroize_poisoned:
            raise ConfigurationError("KeyRing is permanently poisoned after failed zeroization and cannot be reused")
        # Seqlock + Hardware Acquire-Release RMW Reader Protocol
        # Uses self._seq.add(0) which compiles to 'ldaddal' on ARM64 and 'lock xadd' on x86_64:
        # - Acquire semantics on s1 prevent subsequent loads of _state / _shared_cells from floating above s1.
        # - Release semantics on s2 prevent prior loads of _state / _shared_cells from sinking below s2.
        attempts: int = 0
        while attempts < MAX_SEQLOCK_ATTEMPTS:
            if self._shared_attached and ((self._shared_gate.add(0) & SHARED_CLOSING_BIT) != 0 or not self._shared_alive.load()):
                raise ConfigurationError("Shared KeyRing handle has been zeroized or destroyed")
            s1: int = self._seq.add(0)
            if (s1 & 1) != 0:
                attempts = attempts + 1
                continue
            st: KeyRingState = self._state
            need_shared_unpack: bool = False
            raw_len: int = 0
            raw_words: list[int] = []
            if self._shared_attached:
                if st.version != (s1 >> 1) or self._shared_synced_seq != s1:
                    need_shared_unpack = True
                    raw_len = self._shared_len.add(0)
                    raw_words = self._read_shared_words_raw(raw_len)
            s2: int = self._seq.add(0)
            if s1 == s2:
                if self._shared_attached and ((self._shared_gate.add(0) & SHARED_CLOSING_BIT) != 0 or not self._shared_alive.load()):
                    raise ConfigurationError("Shared KeyRing handle has been zeroized or destroyed")
                if need_shared_unpack:
                    if raw_len <= 0 or len(raw_words) == 0:
                        raise ConfigurationError("KeyRing shared state length invalid")
                    canon_str: str = _unpack_shared_words(raw_words, raw_len)
                    st = _deserialize_state_canonical(canon_str)
                st.verify_integrity()
                expected_mac: str = nox.crypto.hmac_sha256(self._seal_key, st.get_seal_hash())
                if not self._shared_attached:
                    if not nox.crypto.constant_time_eq(expected_mac, self._state_mac):
                        raise ConfigurationError("KeyRingState integrity violation: unauthorized state replacement detected")
                if st.version != (s1 >> 1):
                    raise ConfigurationError("KeyRing state version desynchronization detected")
                if self._shared_attached and self._shared_synced_seq != s1:
                    self._state = st
                    self._state_mac = expected_mac
                    self._shared_synced_seq = s1
                return st
            attempts = attempts + 1
        raise ConfigurationError("KeyRing read contention timeout: writer active in critical section")

    def _read_consistent_state(self) -> KeyRingState:
        if self._zeroize_poisoned:
            raise ConfigurationError("KeyRing is permanently poisoned after failed zeroization and cannot be reused")
        if not self._shared_attached:
            return self._read_consistent_state_inner()
        # Acquire single-word CAS reader gate (_shared_gate):
        # Atomically checks (gate & SHARED_CLOSING_BIT) == 0 and increments active_readers
        # in a single CAS loop. If SHARED_CLOSING_BIT is set, immediately fails closed
        # without ever incrementing the reader count or touching any other shared cell.
        if not self._try_acquire_reader_gate():
            raise ConfigurationError("Shared KeyRing handle has been zeroized or destroyed")
        res: KeyRingState = self._state
        try:
            res = self._read_consistent_state_inner()
        except Exception as err:
            self._release_reader_gate()
            raise ConfigurationError(str(err))
        self._release_reader_gate()
        return res

    def get_version(self) -> int:
        return self._read_consistent_state().version

    def get_state(self) -> KeyRingState:
        s: KeyRingState = self._read_consistent_state()
        return KeyRingState(s.version, s.get_keys(), s.created_at)

    def get_snapshot(self) -> list[KeyRef]:
        return self._read_consistent_state().get_keys()

    def acquire_write_lock(self) -> bool:
        return self._write_lock.compare_and_swap(False, True)

    def release_write_lock(self) -> None:
        self._write_lock.store(False)

    def _commit_state(self, base_ver: int, new_state: KeyRingState) -> None:
        if self._zeroize_poisoned:
            raise ConfigurationError("KeyRing is permanently poisoned after failed zeroization and cannot be reused")
        if self._shared_attached and ((self._shared_gate.add(0) & SHARED_CLOSING_BIT) != 0 or not self._shared_alive.load()):
            raise ConfigurationError("Shared KeyRing handle has been zeroized or destroyed")
        # 1. Hardware Atomic Writer Mutex Acquisition (nox_atomic_cas on AtomicBool: casal / lock cmpxchg)
        if not self._write_lock.compare_and_swap(False, True):
            raise ConfigurationError("Concurrent modification in progress: writer mutex lock contention")

        if self._shared_attached and ((self._shared_gate.add(0) & SHARED_CLOSING_BIT) != 0 or not self._shared_alive.load()):
            self._write_lock.store(False)
            raise ConfigurationError("Shared KeyRing handle has been zeroized or destroyed")

        prev_state: KeyRingState = self._state
        prev_mac: str = self._state_mac
        cas_won: bool = False
        seq_odd_entered: bool = False
        committed: bool = False
        odd_seq: int = base_ver * 2 + 1
        even_next_seq: int = (base_ver + 1) * 2
        packed_prev: list[int] = []
        canon_prev_len: int = 0
        try:
            # ==================================================================
            # PHASE A: Pre-Linearization Validation & Staging (Rollback Permitted)
            # ==================================================================
            prev_state.verify_integrity()
            new_state.verify_integrity()
            if prev_state.version != base_ver or new_state.version != (base_ver + 1):
                raise ConfigurationError("Concurrent modification detected: state version mismatch (expected " + str(base_ver) + ")")

            packed_new: list[int] = []
            canon_new_len: int = 0
            if self._shared_attached:
                canon_new: str = _serialize_state_canonical(new_state.version, new_state.get_keys(), new_state.created_at)
                canon_new_len = nox.strings.byte_len(canon_new)
                packed_new = _pack_shared_words(canon_new, len(self._shared_cells))
                canon_prev: str = _serialize_state_canonical(prev_state.version, prev_state.get_keys(), prev_state.created_at)
                canon_prev_len = nox.strings.byte_len(canon_prev)
                packed_prev = _pack_shared_words(canon_prev, len(self._shared_cells))

            new_mac: str = nox.crypto.hmac_sha256(self._seal_key, new_state.get_seal_hash())

            # Hardware Atomic Compare-And-Swap on Version (casal / lock cmpxchg)
            if not self._atomic_version.compare_and_swap(base_ver, base_ver + 1):
                raise ConfigurationError("Concurrent modification detected: atomic CAS version mismatch (expected " + str(base_ver) + ")")
            cas_won = True

            # Enter Seqlock write section with full Acquire-Release RMW fence (casal / lock cmpxchg)
            if not self._seq.compare_and_swap(base_ver * 2, odd_seq):
                raise ConfigurationError("Concurrent modification detected: Seqlock entry CAS mismatch")
            seq_odd_entered = True

            # Stage new state while _seq is odd (invisible to Seqlock readers)
            self._state = new_state
            self._state_mac = new_mac
            if self._shared_attached:
                self._write_shared_words(packed_new, canon_new_len)
                self._shared_synced_seq = even_next_seq

            # ==================================================================
            # PHASE B: Linearization Point (Irreversible Commit)
            # ==================================================================
            # Single hardware Acquire-Release RMW instruction (casal / lock cmpxchg) sealing _seq to even_next_seq.
            # Once this instruction succeeds, the commit is linearized and rollback is strictly forbidden.
            if not self._seq.compare_and_swap(odd_seq, even_next_seq):
                raise ConfigurationError("Seqlock linearization CAS failure")
            committed = True
        except Exception as err:
            # Rollback is strictly permitted ONLY before the Linearization Point (committed == False)
            if not committed:
                if cas_won:
                    self._state = prev_state
                    self._state_mac = prev_mac
                    if self._shared_attached and canon_prev_len > 0:
                        self._write_shared_words(packed_prev, canon_prev_len)
                        self._shared_synced_seq = base_ver * 2
                    self._atomic_version.store(base_ver)
                if seq_odd_entered:
                    self._seq.store(base_ver * 2)
            self._write_lock.store(False)
            raise ConfigurationError(str(err))

        # Release Hardware Writer Mutex after Linearization Point
        self._write_lock.store(False)

    def add_key(self, key: KeyRef, expected_version: int = -1) -> None:
        base_state: KeyRingState = self._read_consistent_state()
        base_ver: int = base_state.version

        # Optimistic concurrency check (CAS)
        if expected_version >= 0 and base_ver != expected_version:
            raise ConfigurationError("KeyRing version mismatch (CAS failed): expected " + str(expected_version) + ", current is " + str(base_ver))

        # Cross-tenant trust domain boundary check
        if key.trust_domain != self.trust_domain:
            raise ConfigurationError("Key trust domain mismatch: key is '" + key.trust_domain + "', keyring is '" + self.trust_domain + "'")
        
        # Unique kid enforcement
        curr_keys: list[KeyRef] = base_state.get_keys()
        i: int = 0
        n: int = len(curr_keys)
        while i < n:
            if curr_keys[i].kid == key.kid:
                raise AmbiguousKeyError("Duplicate key identifier in keyring: " + key.kid)
            i = i + 1
        
        # Enforce single active signing key per algorithm
        if key.state == STATE_ACTIVE_SIGNING:
            j: int = 0
            while j < n:
                existing: KeyRef = curr_keys[j]
                if existing.state == STATE_ACTIVE_SIGNING and existing.algorithm == key.algorithm:
                    raise ConfigurationError("Keyring already has an active signing key for algorithm: " + key.algorithm)
                j = j + 1
        
        # Prepare immutable RCU snapshot
        new_snap: list[KeyRef] = []
        k_idx: int = 0
        while k_idx < n:
            new_snap.append(curr_keys[k_idx])
            k_idx = k_idx + 1
        new_snap.append(key.clone())

        new_state: KeyRingState = KeyRingState(base_ver + 1, new_snap, nox.time.now_ms() // 1000)
        self._commit_state(base_ver, new_state)

    def get_signing_key(self, algorithm: str) -> KeyRef:
        snap: list[KeyRef] = self._read_consistent_state().get_keys()
        i: int = 0
        n: int = len(snap)
        while i < n:
            k: KeyRef = snap[i]
            if k.algorithm == algorithm and k.can_sign():
                return k.clone()
            i = i + 1
        raise KeyUnavailableError("No active signing key available for algorithm: " + algorithm)

    def get_verification_key(self, kid: str, current_time_sec: int = 0) -> KeyRef:
        snap: list[KeyRef] = self._read_consistent_state().get_keys()
        i: int = 0
        n: int = len(snap)
        while i < n:
            k: KeyRef = snap[i]
            if k.kid == kid:
                if k.state == STATE_REVOKED:
                    raise KeyUnavailableError("Key has been revoked: " + kid)
                if not k.can_verify(current_time_sec):
                    raise KeyUnavailableError("Key is retired or past its overlap window: " + kid)
                return k.clone()
            i = i + 1
        raise UnknownKeyError("Key not found in keyring: " + kid)

    def rotate(self, new_key: KeyRef, overlap_seconds: int = 3600,
               clock_time_sec: int = 0, expected_version: int = -1) -> RotationReceipt:
        base_state: KeyRingState = self._read_consistent_state()
        base_ver: int = base_state.version

        # Optimistic concurrency check (CAS)
        if expected_version >= 0 and base_ver != expected_version:
            raise ConfigurationError("KeyRing rotation CAS failed: expected version " + str(expected_version) + ", current is " + str(base_ver))

        now: int = clock_time_sec
        if now <= 0:
            now = nox.time.now_ms() // 1000
        
        # 1. Pre-commit validation phase (validate before mutating existing keys)
        if new_key.trust_domain != self.trust_domain:
            raise ConfigurationError("Key trust domain mismatch: key is '" + new_key.trust_domain + "', keyring is '" + self.trust_domain + "'")
        
        # Check duplicate kid in existing keyring
        curr_keys: list[KeyRef] = base_state.get_keys()
        i: int = 0
        n: int = len(curr_keys)
        while i < n:
            if curr_keys[i].kid == new_key.kid:
                raise AmbiguousKeyError("Duplicate key identifier in keyring: " + new_key.kid)
            i = i + 1
        
        # New key must be in PREPARED or ACTIVE_SIGNING state
        if new_key.state != STATE_PREPARED and new_key.state != STATE_ACTIVE_SIGNING:
            raise ConfigurationError("New key must be in PREPARED or ACTIVE_SIGNING state: got " + new_key.state)
        
        # Find current active signing key for the same algorithm
        old_kid: str = ""
        existing_idx: int = -1
        j: int = 0
        while j < n:
            existing: KeyRef = curr_keys[j]
            if existing.algorithm == new_key.algorithm and existing.state == STATE_ACTIVE_SIGNING:
                old_kid = existing.kid
                existing_idx = j
                break
            j = j + 1
        
        # 2. Prepare Immutable RCU Snapshot
        new_snap: list[KeyRef] = []
        k_i: int = 0
        while k_i < n:
            curr: KeyRef = curr_keys[k_i]
            if k_i == existing_idx:
                demoted: KeyRef = curr.clone()
                demoted.transition_to(STATE_VERIFY_ONLY)
                demoted.retire_at = now + overlap_seconds
                new_snap.append(demoted)
            else:
                new_snap.append(curr.clone())
            k_i = k_i + 1
        
        activated_new: KeyRef = new_key.clone()
        if activated_new.state == STATE_PREPARED:
            activated_new.transition_to(STATE_ACTIVE_SIGNING)
        activated_new.activated_at = now
        new_snap.append(activated_new)

        # 3. Hardware-atomic Seqlock + CAS & Mutex commit
        new_state: KeyRingState = KeyRingState(base_ver + 1, new_snap, now)
        self._commit_state(base_ver, new_state)
        return RotationReceipt(old_kid, new_key.kid, overlap_seconds, now, self.trust_domain)

    def revoke(self, kid: str, expected_version: int = -1) -> None:
        base_state: KeyRingState = self._read_consistent_state()
        base_ver: int = base_state.version

        # Optimistic concurrency check (CAS)
        if expected_version >= 0 and base_ver != expected_version:
            raise ConfigurationError("KeyRing revoke CAS failed: expected version " + str(expected_version) + ", current is " + str(base_ver))

        curr_keys: list[KeyRef] = base_state.get_keys()
        found: bool = False
        new_snap: list[KeyRef] = []
        k_i: int = 0
        n: int = len(curr_keys)
        while k_i < n:
            curr: KeyRef = curr_keys[k_i]
            if curr.kid == kid:
                found = True
                revoked_k: KeyRef = curr.clone()
                revoked_k.transition_to(STATE_REVOKED)
                new_snap.append(revoked_k)
            else:
                new_snap.append(curr.clone())
            k_i = k_i + 1
        if not found:
            raise UnknownKeyError("Cannot revoke unknown key: " + kid)

        # Hardware-atomic Seqlock + CAS & Mutex commit
        new_state: KeyRingState = KeyRingState(base_ver + 1, new_snap, nox.time.now_ms() // 1000)
        self._commit_state(base_ver, new_state)

    def purge_expired_keys(self, current_time_sec: int, expected_version: int = -1) -> int:
        # Atomically compacts the KeyRing by removing RETIRED, REVOKED, and expired
        # VERIFY_ONLY keys (retire_at > 0 and current_time_sec >= retire_at), keeping
        # shared atomic state compact across long-running rotation lifecycles.
        if current_time_sec <= 0:
            raise ConfigurationError("purge_expired_keys requires a positive current_time_sec timestamp")
        base_state: KeyRingState = self._read_consistent_state()
        base_ver: int = base_state.version

        if expected_version >= 0 and base_ver != expected_version:
            raise ConfigurationError("KeyRing purge CAS failed: expected version " + str(expected_version) + ", current is " + str(base_ver))

        curr_keys: list[KeyRef] = base_state.get_keys()
        retained: list[KeyRef] = []
        purged_count: int = 0
        i: int = 0
        n: int = len(curr_keys)
        while i < n:
            k: KeyRef = curr_keys[i]
            should_purge: bool = False
            if k.state == STATE_RETIRED or k.state == STATE_REVOKED:
                should_purge = True
            elif k.state == STATE_VERIFY_ONLY and k.retire_at > 0 and current_time_sec >= k.retire_at:
                should_purge = True
            if should_purge:
                purged_count = purged_count + 1
            else:
                retained.append(k.clone())
            i = i + 1

        if purged_count == 0 and expected_version < 0:
            return 0

        new_state: KeyRingState = KeyRingState(base_ver + 1, retained, current_time_sec)
        self._commit_state(base_ver, new_state)
        return purged_count
