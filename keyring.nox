# Cipher — KeyRing & Safe Key Lifecycle Management
# Enforces trust domain isolation, unique kid indexing, zero dual-active signers,
# tamper-evident SHA-256 snapshot sealing, Seqlock coherent reads, and exception-safe hardware atomic CAS.

import nox.atomic
import nox.crypto
import nox.strings
import nox.time
from cipher.errors import AmbiguousKeyError, ConfigurationError, KeyUnavailableError, UnknownKeyError
from cipher.keys import KeyRef, STATE_ACTIVE_SIGNING, STATE_PREPARED, STATE_RETIRED, STATE_REVOKED, STATE_VERIFY_ONLY
from cipher.rotation import RotationReceipt

def _compute_state_seal(version: int, keys: list[KeyRef], created_at: int) -> str:
    raw: str = "CIPHER-KR-SEAL-V1|" + str(version) + "|" + str(created_at) + "|" + str(len(keys))
    i: int = 0
    n: int = len(keys)
    while i < n:
        k: KeyRef = keys[i]
        raw = raw + "|" + k.kid + ":" + k.algorithm + ":" + k.state + ":" + k.trust_domain + ":" + str(k.activated_at) + ":" + str(k.retire_at) + ":" + k.secret_material
        i = i + 1
    return nox.crypto.sha256(raw)

class KeyRingState:
    version: int
    _keys: list[KeyRef]
    created_at: int
    _integrity_hash: str

    def __init__(self, version: int, keys: list[KeyRef], created_at: int = 0) -> None:
        self.version = version
        # Deep defensive clone on construction: caller cannot retain mutable handle to internal list or KeyRefs
        cloned: list[KeyRef] = []
        i: int = 0
        n: int = len(keys)
        while i < n:
            cloned.append(keys[i].clone())
            i = i + 1
        self._keys = cloned
        self.created_at = created_at
        self._integrity_hash = _compute_state_seal(self.version, self._keys, self.created_at)

    def verify_integrity(self) -> None:
        expected: str = _compute_state_seal(self.version, self._keys, self.created_at)
        if not nox.crypto.constant_time_eq(expected, self._integrity_hash):
            raise ConfigurationError("KeyRingState integrity violation: unauthorized direct field mutation detected")

    def get_keys(self) -> list[KeyRef]:
        self.verify_integrity()
        # Return deep defensive clone on every inspection: external mutations never corrupt snapshot
        snap: list[KeyRef] = []
        i: int = 0
        n: int = len(self._keys)
        while i < n:
            snap.append(self._keys[i].clone())
            i = i + 1
        return snap

    def key_count(self) -> int:
        self.verify_integrity()
        return len(self._keys)

class KeyRing:
    trust_domain: str
    _state: KeyRingState
    _write_lock: nox.atomic.AtomicBool
    _seq: nox.atomic.AtomicInt
    _atomic_version: nox.atomic.AtomicInt

    def __init__(self, trust_domain: str = "default") -> None:
        self.trust_domain = trust_domain
        initial_keys: list[KeyRef] = []
        self._state = KeyRingState(0, initial_keys, 0)
        self._write_lock = nox.atomic.new_bool(False)
        self._seq = nox.atomic.new_int(0)
        self._atomic_version = nox.atomic.new_int(0)

    def get_lock_handle(self) -> int:
        return self._write_lock.handle

    def get_seq_handle(self) -> int:
        return self._seq.handle

    def get_version_handle(self) -> int:
        return self._atomic_version.handle

    def bind_shared_atomics(self, lock_handle: int, seq_handle: int, ver_handle: int) -> None:
        self._write_lock = nox.atomic.from_bool_handle(lock_handle)
        self._seq = nox.atomic.from_int_handle(seq_handle)
        self._atomic_version = nox.atomic.from_int_handle(ver_handle)

    def _read_consistent_state(self) -> KeyRingState:
        # Seqlock + Single-Truth Snapshot Reader Protocol
        # Guarantees that version and key snapshot are always observed as a coherent atomic unit.
        attempts: int = 0
        while attempts < 1024:
            s1: int = self._seq.load()
            if (s1 & 1) != 0:
                attempts = attempts + 1
                continue
            st: KeyRingState = self._state
            s2: int = self._seq.load()
            if s1 == s2:
                st.verify_integrity()
                if st.version != (s1 >> 1):
                    raise ConfigurationError("KeyRing state version desynchronization detected")
                return st
            attempts = attempts + 1
        raise ConfigurationError("KeyRing read contention timeout: writer active in critical section")

    def get_version(self) -> int:
        return self._read_consistent_state().version

    def get_state(self) -> KeyRingState:
        s: KeyRingState = self._read_consistent_state()
        return KeyRingState(s.version, s.get_keys(), s.created_at)

    def get_snapshot(self) -> list[KeyRef]:
        return self._read_consistent_state().get_keys()

    def acquire_write_lock(self) -> bool:
        return self._write_lock.compare_and_swap(False, True)

    def release_write_lock(self) -> None:
        self._write_lock.store(False)

    def _commit_state(self, base_ver: int, new_state: KeyRingState) -> None:
        # 1. Hardware Atomic Writer Mutex Acquisition (nox_atomic_cas on AtomicBool)
        if not self._write_lock.compare_and_swap(False, True):
            raise ConfigurationError("Concurrent modification in progress: writer mutex lock contention")

        prev_state: KeyRingState = self._state
        cas_won: bool = False
        try:
            # 2. Verify snapshot seal integrity and base version under exclusive writer lock
            prev_state.verify_integrity()
            new_state.verify_integrity()
            if prev_state.version != base_ver or new_state.version != (base_ver + 1):
                raise ConfigurationError("Concurrent modification detected: state version mismatch (expected " + str(base_ver) + ")")

            # 3. Hardware Atomic Compare-And-Swap on Version (nox_atomic_cas on AtomicInt)
            if not self._atomic_version.compare_and_swap(base_ver, base_ver + 1):
                raise ConfigurationError("Concurrent modification detected: atomic CAS version mismatch (expected " + str(base_ver) + ")")
            cas_won = True

            # 4. Enter Seqlock write section (odd sequence value signals in-flight state transition)
            self._seq.store(base_ver * 2 + 1)

            # 5. Publish new unified KeyRingState reference FIRST
            self._state = new_state

            # 6. Seal Seqlock write section (even sequence value = 2 * new_state.version)
            self._seq.store((base_ver + 1) * 2)
        except Exception as err:
            # Exception-safe rollback (only if this writer won CAS) & guaranteed writer lock release
            if cas_won:
                self._state = prev_state
                self._atomic_version.store(base_ver)
                self._seq.store(base_ver * 2)
            self._write_lock.store(False)
            raise ConfigurationError(str(err))

        # 7. Release Hardware Writer Mutex
        self._write_lock.store(False)

    def add_key(self, key: KeyRef, expected_version: int = -1) -> None:
        base_state: KeyRingState = self._read_consistent_state()
        base_ver: int = base_state.version

        # Optimistic concurrency check (CAS)
        if expected_version >= 0 and base_ver != expected_version:
            raise ConfigurationError("KeyRing version mismatch (CAS failed): expected " + str(expected_version) + ", current is " + str(base_ver))

        # Cross-tenant trust domain boundary check
        if key.trust_domain != self.trust_domain:
            raise ConfigurationError("Key trust domain mismatch: key is '" + key.trust_domain + "', keyring is '" + self.trust_domain + "'")
        
        # Unique kid enforcement
        curr_keys: list[KeyRef] = base_state.get_keys()
        i: int = 0
        n: int = len(curr_keys)
        while i < n:
            if curr_keys[i].kid == key.kid:
                raise AmbiguousKeyError("Duplicate key identifier in keyring: " + key.kid)
            i = i + 1
        
        # Enforce single active signing key per algorithm
        if key.state == STATE_ACTIVE_SIGNING:
            j: int = 0
            while j < n:
                existing: KeyRef = curr_keys[j]
                if existing.state == STATE_ACTIVE_SIGNING and existing.algorithm == key.algorithm:
                    raise ConfigurationError("Keyring already has an active signing key for algorithm: " + key.algorithm)
                j = j + 1
        
        # Prepare immutable RCU snapshot
        new_snap: list[KeyRef] = []
        k_idx: int = 0
        while k_idx < n:
            new_snap.append(curr_keys[k_idx])
            k_idx = k_idx + 1
        new_snap.append(key.clone())

        new_state: KeyRingState = KeyRingState(base_ver + 1, new_snap, nox.time.now_ms() // 1000)
        self._commit_state(base_ver, new_state)

    def get_signing_key(self, algorithm: str) -> KeyRef:
        snap: list[KeyRef] = self._read_consistent_state().get_keys()
        i: int = 0
        n: int = len(snap)
        while i < n:
            k: KeyRef = snap[i]
            if k.algorithm == algorithm and k.can_sign():
                return k.clone()
            i = i + 1
        raise KeyUnavailableError("No active signing key available for algorithm: " + algorithm)

    def get_verification_key(self, kid: str, current_time_sec: int = 0) -> KeyRef:
        snap: list[KeyRef] = self._read_consistent_state().get_keys()
        i: int = 0
        n: int = len(snap)
        while i < n:
            k: KeyRef = snap[i]
            if k.kid == kid:
                if k.state == STATE_REVOKED:
                    raise KeyUnavailableError("Key has been revoked: " + kid)
                if not k.can_verify(current_time_sec):
                    raise KeyUnavailableError("Key is retired or past its overlap window: " + kid)
                return k.clone()
            i = i + 1
        raise UnknownKeyError("Key not found in keyring: " + kid)

    def rotate(self, new_key: KeyRef, overlap_seconds: int = 3600,
               clock_time_sec: int = 0, expected_version: int = -1) -> RotationReceipt:
        base_state: KeyRingState = self._read_consistent_state()
        base_ver: int = base_state.version

        # Optimistic concurrency check (CAS)
        if expected_version >= 0 and base_ver != expected_version:
            raise ConfigurationError("KeyRing rotation CAS failed: expected version " + str(expected_version) + ", current is " + str(base_ver))

        now: int = clock_time_sec
        if now <= 0:
            now = nox.time.now_ms() // 1000
        
        # 1. Pre-commit validation phase (validate before mutating existing keys)
        if new_key.trust_domain != self.trust_domain:
            raise ConfigurationError("Key trust domain mismatch: key is '" + new_key.trust_domain + "', keyring is '" + self.trust_domain + "'")
        
        # Check duplicate kid in existing keyring
        curr_keys: list[KeyRef] = base_state.get_keys()
        i: int = 0
        n: int = len(curr_keys)
        while i < n:
            if curr_keys[i].kid == new_key.kid:
                raise AmbiguousKeyError("Duplicate key identifier in keyring: " + new_key.kid)
            i = i + 1
        
        # New key must be in PREPARED or ACTIVE_SIGNING state
        if new_key.state != STATE_PREPARED and new_key.state != STATE_ACTIVE_SIGNING:
            raise ConfigurationError("New key must be in PREPARED or ACTIVE_SIGNING state: got " + new_key.state)
        
        # Find current active signing key for the same algorithm
        old_kid: str = ""
        existing_idx: int = -1
        j: int = 0
        while j < n:
            existing: KeyRef = curr_keys[j]
            if existing.algorithm == new_key.algorithm and existing.state == STATE_ACTIVE_SIGNING:
                old_kid = existing.kid
                existing_idx = j
                break
            j = j + 1
        
        # 2. Prepare Immutable RCU Snapshot
        new_snap: list[KeyRef] = []
        k_i: int = 0
        while k_i < n:
            curr: KeyRef = curr_keys[k_i]
            if k_i == existing_idx:
                demoted: KeyRef = curr.clone()
                demoted.transition_to(STATE_VERIFY_ONLY)
                demoted.retire_at = now + overlap_seconds
                new_snap.append(demoted)
            else:
                new_snap.append(curr.clone())
            k_i = k_i + 1
        
        activated_new: KeyRef = new_key.clone()
        if activated_new.state == STATE_PREPARED:
            activated_new.transition_to(STATE_ACTIVE_SIGNING)
        activated_new.activated_at = now
        new_snap.append(activated_new)

        # 3. Hardware-atomic Seqlock + CAS & Mutex commit
        new_state: KeyRingState = KeyRingState(base_ver + 1, new_snap, now)
        self._commit_state(base_ver, new_state)
        return RotationReceipt(old_kid, new_key.kid, overlap_seconds, now, self.trust_domain)

    def revoke(self, kid: str, expected_version: int = -1) -> None:
        base_state: KeyRingState = self._read_consistent_state()
        base_ver: int = base_state.version

        # Optimistic concurrency check (CAS)
        if expected_version >= 0 and base_ver != expected_version:
            raise ConfigurationError("KeyRing revoke CAS failed: expected version " + str(expected_version) + ", current is " + str(base_ver))

        curr_keys: list[KeyRef] = base_state.get_keys()
        found: bool = False
        new_snap: list[KeyRef] = []
        k_i: int = 0
        n: int = len(curr_keys)
        while k_i < n:
            curr: KeyRef = curr_keys[k_i]
            if curr.kid == kid:
                found = True
                revoked_k: KeyRef = curr.clone()
                revoked_k.transition_to(STATE_REVOKED)
                new_snap.append(revoked_k)
            else:
                new_snap.append(curr.clone())
            k_i = k_i + 1
        if not found:
            raise UnknownKeyError("Cannot revoke unknown key: " + kid)

        # Hardware-atomic Seqlock + CAS & Mutex commit
        new_state: KeyRingState = KeyRingState(base_ver + 1, new_snap, nox.time.now_ms() // 1000)
        self._commit_state(base_ver, new_state)
