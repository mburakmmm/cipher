# Cipher — KeyRing & Safe Key Lifecycle Management
# Enforces trust domain isolation, unique kid indexing, zero dual-active signers, and atomic rotation.

import nox.strings
import nox.time
from errors import AmbiguousKeyError, ConfigurationError, KeyUnavailableError, UnknownKeyError
from keys import KeyRef, STATE_ACTIVE_SIGNING, STATE_PREPARED, STATE_RETIRED, STATE_REVOKED, STATE_VERIFY_ONLY
from rotation import RotationReceipt

class KeyRingState:
    version: int
    keys: list[KeyRef]
    created_at: int

    def __init__(self, version: int, keys: list[KeyRef], created_at: int = 0) -> None:
        self.version = version
        self.keys = keys
        self.created_at = created_at

class KeyRing:
    trust_domain: str
    state: KeyRingState
    keys: list[KeyRef]  # Direct snapshot alias for backward compatibility

    def __init__(self, trust_domain: str = "default") -> None:
        self.trust_domain = trust_domain
        initial_keys: list[KeyRef] = []
        self.state = KeyRingState(0, initial_keys, 0)
        self.keys = initial_keys

    def get_version(self) -> int:
        return self.state.version

    def get_snapshot(self) -> list[KeyRef]:
        curr_keys: list[KeyRef] = self.state.keys
        snap: list[KeyRef] = []
        i: int = 0
        n: int = len(curr_keys)
        while i < n:
            snap.append(curr_keys[i].clone())
            i = i + 1
        return snap

    def add_key(self, key: KeyRef, expected_version: int = -1) -> None:
        base_state: KeyRingState = self.state

        # Optimistic concurrency check (CAS)
        if expected_version >= 0 and base_state.version != expected_version:
            raise ConfigurationError("KeyRing version mismatch (CAS failed): expected " + str(expected_version) + ", current is " + str(base_state.version))

        # Cross-tenant trust domain boundary check
        if key.trust_domain != self.trust_domain:
            raise ConfigurationError("Key trust domain mismatch: key is '" + key.trust_domain + "', keyring is '" + self.trust_domain + "'")
        
        # Unique kid enforcement
        curr_keys: list[KeyRef] = base_state.keys
        i: int = 0
        n: int = len(curr_keys)
        while i < n:
            if curr_keys[i].kid == key.kid:
                raise AmbiguousKeyError("Duplicate key identifier in keyring: " + key.kid)
            i = i + 1
        
        # Enforce single active signing key per algorithm
        if key.state == STATE_ACTIVE_SIGNING:
            j: int = 0
            while j < n:
                existing: KeyRef = curr_keys[j]
                if existing.state == STATE_ACTIVE_SIGNING and existing.algorithm == key.algorithm:
                    raise ConfigurationError("Keyring already has an active signing key for algorithm: " + key.algorithm)
                j = j + 1
        
        # Immutable RCU publish
        new_snap: list[KeyRef] = []
        k_idx: int = 0
        while k_idx < n:
            new_snap.append(curr_keys[k_idx])
            k_idx = k_idx + 1
        new_snap.append(key.clone())

        # Atomic commit & lost-update detection:
        if self.state.version != base_state.version:
            raise ConfigurationError("Concurrent modification detected: keyring state changed during preparation")

        new_state: KeyRingState = KeyRingState(base_state.version + 1, new_snap, nox.time.now_ms() // 1000)
        self.state = new_state
        self.keys = new_snap

    def get_signing_key(self, algorithm: str) -> KeyRef:
        snap: list[KeyRef] = self.state.keys
        i: int = 0
        n: int = len(snap)
        while i < n:
            k: KeyRef = snap[i]
            if k.algorithm == algorithm and k.can_sign():
                # Defensive cloning: Caller cannot mutate internal snapshot state
                return k.clone()
            i = i + 1
        raise KeyUnavailableError("No active signing key available for algorithm: " + algorithm)

    def get_verification_key(self, kid: str, current_time_sec: int = 0) -> KeyRef:
        snap: list[KeyRef] = self.state.keys
        i: int = 0
        n: int = len(snap)
        while i < n:
            k: KeyRef = snap[i]
            if k.kid == kid:
                if k.state == STATE_REVOKED:
                    raise KeyUnavailableError("Key has been revoked: " + kid)
                if not k.can_verify(current_time_sec):
                    raise KeyUnavailableError("Key is retired or past its overlap window: " + kid)
                # Defensive cloning: Caller cannot mutate internal snapshot state
                return k.clone()
            i = i + 1
        raise UnknownKeyError("Key not found in keyring: " + kid)

    def rotate(self, new_key: KeyRef, overlap_seconds: int = 3600,
               clock_time_sec: int = 0, expected_version: int = -1) -> RotationReceipt:
        base_state: KeyRingState = self.state

        # Optimistic concurrency check (CAS)
        if expected_version >= 0 and base_state.version != expected_version:
            raise ConfigurationError("KeyRing rotation CAS failed: expected version " + str(expected_version) + ", current is " + str(base_state.version))

        now: int = clock_time_sec
        if now <= 0:
            now = nox.time.now_ms() // 1000
        
        # 1. Pre-commit validation phase (validate before mutating existing keys)
        if new_key.trust_domain != self.trust_domain:
            raise ConfigurationError("Key trust domain mismatch: key is '" + new_key.trust_domain + "', keyring is '" + self.trust_domain + "'")
        
        # Check duplicate kid in existing keyring
        curr_keys: list[KeyRef] = base_state.keys
        i: int = 0
        n: int = len(curr_keys)
        while i < n:
            if curr_keys[i].kid == new_key.kid:
                raise AmbiguousKeyError("Duplicate key identifier in keyring: " + new_key.kid)
            i = i + 1
        
        # New key must be in PREPARED or ACTIVE_SIGNING state
        if new_key.state != STATE_PREPARED and new_key.state != STATE_ACTIVE_SIGNING:
            raise ConfigurationError("New key must be in PREPARED or ACTIVE_SIGNING state: got " + new_key.state)
        
        # Find current active signing key for the same algorithm
        old_kid: str = ""
        existing_idx: int = -1
        j: int = 0
        while j < n:
            existing: KeyRef = curr_keys[j]
            if existing.algorithm == new_key.algorithm and existing.state == STATE_ACTIVE_SIGNING:
                old_kid = existing.kid
                existing_idx = j
                break
            j = j + 1
        
        # 2. Immutable RCU Snapshot Commit phase
        new_snap: list[KeyRef] = []
        k_i: int = 0
        while k_i < n:
            curr: KeyRef = curr_keys[k_i]
            if k_i == existing_idx:
                demoted: KeyRef = curr.clone()
                demoted.transition_to(STATE_VERIFY_ONLY)
                demoted.retire_at = now + overlap_seconds
                new_snap.append(demoted)
            else:
                new_snap.append(curr.clone())
            k_i = k_i + 1
        
        activated_new: KeyRef = new_key.clone()
        if activated_new.state == STATE_PREPARED:
            activated_new.transition_to(STATE_ACTIVE_SIGNING)
        activated_new.activated_at = now
        new_snap.append(activated_new)

        # Atomic commit & lost-update detection:
        if self.state.version != base_state.version:
            raise ConfigurationError("Concurrent modification detected: keyring state changed during preparation")

        # Single-step atomic reference publication of entire state (version + keys together)
        new_state: KeyRingState = KeyRingState(base_state.version + 1, new_snap, now)
        self.state = new_state
        self.keys = new_snap
        return RotationReceipt(old_kid, new_key.kid, overlap_seconds, now, self.trust_domain)

    def revoke(self, kid: str, expected_version: int = -1) -> None:
        base_state: KeyRingState = self.state

        # Optimistic concurrency check (CAS)
        if expected_version >= 0 and base_state.version != expected_version:
            raise ConfigurationError("KeyRing revoke CAS failed: expected version " + str(expected_version) + ", current is " + str(base_state.version))

        curr_keys: list[KeyRef] = base_state.keys
        found: bool = False
        new_snap: list[KeyRef] = []
        k_i: int = 0
        n: int = len(curr_keys)
        while k_i < n:
            curr: KeyRef = curr_keys[k_i]
            if curr.kid == kid:
                found = True
                revoked_k: KeyRef = curr.clone()
                revoked_k.transition_to(STATE_REVOKED)
                new_snap.append(revoked_k)
            else:
                new_snap.append(curr.clone())
            k_i = k_i + 1
        if not found:
            raise UnknownKeyError("Cannot revoke unknown key: " + kid)

        # Atomic commit & lost-update detection:
        if self.state.version != base_state.version:
            raise ConfigurationError("Concurrent modification detected: keyring state changed during preparation")

        # Single-step atomic reference publication of entire state (version + keys together)
        new_state: KeyRingState = KeyRingState(base_state.version + 1, new_snap, nox.time.now_ms() // 1000)
        self.state = new_state
        self.keys = new_snap
