# Cipher — JSON Web Key (JWK) and RFC 7638 Thumbprint Standard
# Enforces safe public JWK export (zero private key leakage) and minimum key size requirements.

import nox.crypto
import nox.strings
from cipher.encoding import decode_base64url, decode_base64url_hex, encode_base64url, encode_base64url_from_hex, hex_to_bytes, validate_base64url_syntax
from cipher.errors import EncodingError, InvalidKeyError, JsonFormatError
from cipher.json_strict import get_string_field, has_field, is_object, parse_strict_json

MIN_RSA_MODULUS_CHARS: int = 342  # RFC 7518 §3.3: 2048-bit modulus (256 bytes) requires at least 342 unpadded Base64URL characters (2040 bits is only 340 chars)
MAX_RSA_EXPONENT_CHARS: int = 11  # Upper bound for safe integer RSA public exponent (IEEE 754 53-bit safe integer limit; e.g. 65537 'AQAB' is 4 chars)
MAX_SAFE_INT_BEFORE_SHIFT: int = 140737488355327  # (2^53 - 1) >> 6: IEEE 754 53-bit safe integer overflow prevention boundary
ED25519_COORD_BYTES: int = 32
ED25519_COORD_HEX_LEN: int = 64
P256_COORD_BYTES: int = 32
P256_COORD_HEX_LEN: int = 64



def _b64_char_to_val(code: int) -> int:
    if code >= 65 and code <= 90:
        return code - 65
    if code >= 97 and code <= 122:
        return code - 71
    if code >= 48 and code <= 57:
        return code + 4
    if code == 45:
        return 62
    if code == 95:
        return 63
    return -1

def _b64url_to_uint(s: str) -> int:
    n: int = len(s)
    rem: int = n % 4
    if n == 0 or rem == 1:
        raise InvalidKeyError("Invalid Base64URL integer length")
    
    val: int = 0
    i: int = 0
    while i < n:
        code: int = ord(s[i])
        c_val: int = _b64_char_to_val(code)
        if c_val < 0:
            raise InvalidKeyError("Invalid character in Base64URL integer")
        if val > MAX_SAFE_INT_BEFORE_SHIFT:
            raise InvalidKeyError("Integer overflow detected while decoding Base64URL integer")
        val = (val << 6) | c_val
        i = i + 1
    
    if rem == 2:
        return val >> 4
    if rem == 3:
        return val >> 2
    return val

class JwkKey:
    kty: str
    kid: str
    alg: str
    use: str
    # RSA fields
    n: str
    e: str
    d: str
    # Symmetric fields
    k: str
    # EC / OKP fields
    crv: str
    x: str
    y: str

    def __init__(self, kty: str, kid: str = "", alg: str = "", use: str = "sig",
                 n: str = "", e: str = "", d: str = "", k: str = "",
                 crv: str = "", x: str = "", y: str = "") -> None:
        self.kty = kty
        self.kid = kid
        self.alg = alg
        self.use = use
        self.n = n
        self.e = e
        self.d = d
        self.k = k
        self.crv = crv
        self.x = x
        self.y = y

        if self.use != "" and self.use != "sig":
            raise InvalidKeyError("JWK 'use' must be 'sig' when provided")

        if self.kty == "RSA":
            if self.alg != "" and self.alg != "RS256" and self.alg != "RS384" and self.alg != "RS512" and self.alg != "PS256" and self.alg != "PS384" and self.alg != "PS512":
                raise InvalidKeyError("Incompatible 'alg' for RSA JWK: " + self.alg)
            if self.n == "" or self.e == "":
                raise InvalidKeyError("RSA JWK must contain both 'n' and 'e' parameters")
            
            # 1. Base64URL syntax validation
            try:
                validate_base64url_syntax(self.n)
            except EncodingError:
                raise InvalidKeyError("RSA modulus 'n' has invalid Base64URL syntax")
            try:
                validate_base64url_syntax(self.e)
            except EncodingError:
                raise InvalidKeyError("RSA public exponent 'e' has invalid Base64URL syntax")

            # 2. Modulus 'n' size and structural validation
            # Enforce minimum 2048 bits (256 bytes) for RSA
            # In Base64URL (RFC 7518 §3.3), a 256-byte modulus encodes to 342 unpadded characters.
            if len(self.n) < MIN_RSA_MODULUS_CHARS:
                raise InvalidKeyError("RSA modulus 'n' must be at least 2048 bits (256 bytes, 342 Base64URL chars)")
            
            n_c0: int = _b64_char_to_val(ord(self.n[0]))
            n_c1: int = _b64_char_to_val(ord(self.n[1]))
            n_first_byte: int = (n_c0 << 2) | (n_c1 >> 4)
            if n_first_byte == 0:
                raise InvalidKeyError("RSA modulus 'n' must not contain leading zero octets (RFC 7518 §6.3.1.1)")
            if len(self.n) == MIN_RSA_MODULUS_CHARS and (n_first_byte & 128) == 0:
                raise InvalidKeyError("RSA modulus 'n' has MSB equal to zero (fewer than 2048 bits)")

            # 3. Public exponent 'e' validation (RFC 7518 §6.3.1.2)
            if len(self.e) == 0 or len(self.e) % 4 == 1:
                raise InvalidKeyError("RSA public exponent 'e' has invalid Base64URL length")
            if len(self.e) > MAX_RSA_EXPONENT_CHARS:
                raise InvalidKeyError("RSA public exponent 'e' exceeds maximum allowable length of " + str(MAX_RSA_EXPONENT_CHARS) + " characters")
            e_c0: int = _b64_char_to_val(ord(self.e[0]))
            e_c1: int = _b64_char_to_val(ord(self.e[1]))
            e_first_byte: int = (e_c0 << 2) | (e_c1 >> 4)
            if e_first_byte == 0:
                raise InvalidKeyError("RSA exponent 'e' must not contain leading zero octets (RFC 7518 §6.3.1.2)")
            
            e_val: int = _b64url_to_uint(self.e)
            if e_val <= 1:
                raise InvalidKeyError("RSA public exponent 'e' must be greater than 1")
            if e_val % 2 == 0:
                raise InvalidKeyError("RSA public exponent 'e' must be an odd positive integer")
            return

        if self.kty == "OKP":
            if self.crv != "Ed25519":
                raise InvalidKeyError("Unsupported OKP curve (only 'Ed25519' is permitted): " + self.crv)
            if self.alg != "" and self.alg != "EdDSA":
                raise InvalidKeyError("Incompatible 'alg' for OKP Ed25519 JWK: " + self.alg)
            if self.x == "":
                raise InvalidKeyError("OKP JWK must contain public coordinate 'x'")
            x_hex: str = ""
            try:
                x_hex = decode_base64url_hex(self.x)
            except EncodingError:
                raise InvalidKeyError("OKP 'x' coordinate has invalid Base64URL syntax")
            if nox.strings.byte_len(x_hex) != ED25519_COORD_HEX_LEN:
                raise InvalidKeyError("OKP Ed25519 'x' coordinate must decode to exactly 32 bytes")
            if encode_base64url_from_hex(x_hex) != self.x:
                raise InvalidKeyError("OKP Ed25519 'x' coordinate is non-canonical Base64URL")
            if self.d != "":
                d_hex: str = ""
                try:
                    d_hex = decode_base64url_hex(self.d)
                except EncodingError:
                    raise InvalidKeyError("OKP 'd' private key has invalid Base64URL syntax")
                if nox.strings.byte_len(d_hex) != ED25519_COORD_HEX_LEN:
                    raise InvalidKeyError("OKP Ed25519 'd' private key must decode to exactly 32 bytes")
            return

        if self.kty == "EC":
            if self.crv != "P-256":
                raise InvalidKeyError("Unsupported EC curve (only 'P-256' is permitted): " + self.crv)
            if self.alg != "" and self.alg != "ES256":
                raise InvalidKeyError("Incompatible 'alg' for EC P-256 JWK: " + self.alg)
            if self.x == "" or self.y == "":
                raise InvalidKeyError("EC P-256 JWK must contain both 'x' and 'y' coordinates")
            ec_x_hex: str = ""
            ec_y_hex: str = ""
            try:
                ec_x_hex = decode_base64url_hex(self.x)
                ec_y_hex = decode_base64url_hex(self.y)
            except EncodingError:
                raise InvalidKeyError("EC 'x'/'y' coordinate has invalid Base64URL syntax")
            if nox.strings.byte_len(ec_x_hex) != P256_COORD_HEX_LEN or nox.strings.byte_len(ec_y_hex) != P256_COORD_HEX_LEN:
                raise InvalidKeyError("EC P-256 'x' and 'y' coordinates must each decode to exactly 32 bytes")
            if encode_base64url_from_hex(ec_x_hex) != self.x or encode_base64url_from_hex(ec_y_hex) != self.y:
                raise InvalidKeyError("EC P-256 coordinates must use canonical Base64URL encoding")
            if self.d != "":
                ec_d_hex: str = ""
                try:
                    ec_d_hex = decode_base64url_hex(self.d)
                except EncodingError:
                    raise InvalidKeyError("EC 'd' private scalar has invalid Base64URL syntax")
                if nox.strings.byte_len(ec_d_hex) != P256_COORD_HEX_LEN:
                    raise InvalidKeyError("EC P-256 'd' private scalar must decode to exactly 32 bytes")
            return

        if self.kty == "oct":
            if self.alg != "" and self.alg != "HS256" and self.alg != "HS384" and self.alg != "HS512":
                raise InvalidKeyError("Incompatible 'alg' for symmetric 'oct' JWK: " + self.alg)
            if self.k == "":
                raise InvalidKeyError("Symmetric 'oct' JWK must contain 'k' parameter")
            return

        raise InvalidKeyError("Unsupported JWK key type 'kty': " + self.kty)

    def is_private(self) -> bool:
        if self.kty == "RSA" or self.kty == "OKP" or self.kty == "EC":
            return self.d != ""
        if self.kty == "oct":
            return True
        return False

    def to_ed25519_public_hex(self) -> str:
        if self.kty != "OKP" or self.crv != "Ed25519":
            raise InvalidKeyError("Key is not an OKP Ed25519 JWK")
        return decode_base64url_hex(self.x)

    def to_ed25519_private_hex(self) -> str:
        if self.kty != "OKP" or self.crv != "Ed25519" or self.d == "":
            raise InvalidKeyError("OKP Ed25519 JWK does not contain private key material 'd'")
        return decode_base64url_hex(self.d)

    def to_public_json(self) -> str:
        # Invariant: Never export private 'd' or symmetric secret 'k'
        if self.kty == "RSA":
            out: str = "{\"kty\":\"RSA\",\"n\":\"" + self.n + "\",\"e\":\"" + self.e + "\""
            if self.kid != "":
                out = out + ",\"kid\":\"" + self.kid + "\""
            if self.alg != "":
                out = out + ",\"alg\":\"" + self.alg + "\""
            if self.use != "":
                out = out + ",\"use\":\"" + self.use + "\""
            out = out + "}"
            return out

        if self.kty == "OKP":
            out_okp: str = "{\"kty\":\"OKP\",\"crv\":\"" + self.crv + "\",\"x\":\"" + self.x + "\""
            if self.kid != "":
                out_okp = out_okp + ",\"kid\":\"" + self.kid + "\""
            if self.alg != "":
                out_okp = out_okp + ",\"alg\":\"" + self.alg + "\""
            if self.use != "":
                out_okp = out_okp + ",\"use\":\"" + self.use + "\""
            out_okp = out_okp + "}"
            return out_okp

        if self.kty == "EC":
            out_ec: str = "{\"kty\":\"EC\",\"crv\":\"" + self.crv + "\",\"x\":\"" + self.x + "\",\"y\":\"" + self.y + "\""
            if self.kid != "":
                out_ec = out_ec + ",\"kid\":\"" + self.kid + "\""
            if self.alg != "":
                out_ec = out_ec + ",\"alg\":\"" + self.alg + "\""
            if self.use != "":
                out_ec = out_ec + ",\"use\":\"" + self.use + "\""
            out_ec = out_ec + "}"
            return out_ec
        
        if self.kty == "oct":
            # RFC 7517: Symmetric keys MUST NOT be exported as public JWKs
            raise InvalidKeyError("Symmetric octet keys cannot be exported as public JWK")
        
        raise InvalidKeyError("Unsupported key type for public export: " + self.kty)

    def thumbprint_sha256(self) -> str:
        # RFC 7638 §3.2: Lexicographically ordered required members without whitespace
        if self.kty == "RSA":
            # Lexicographical order: e, kty, n
            canonical_json: str = "{\"e\":\"" + self.e + "\",\"kty\":\"RSA\",\"n\":\"" + self.n + "\"}"
            hex_hash: str = nox.crypto.sha256(canonical_json)
            raw_hash: str = hex_to_bytes(hex_hash)
            return encode_base64url(raw_hash)

        if self.kty == "OKP":
            # Lexicographical order: crv, kty, x
            canonical_okp: str = "{\"crv\":\"" + self.crv + "\",\"kty\":\"OKP\",\"x\":\"" + self.x + "\"}"
            hex_okp: str = nox.crypto.sha256(canonical_okp)
            return encode_base64url_from_hex(hex_okp)

        if self.kty == "EC":
            # Lexicographical order: crv, kty, x, y
            canonical_ec: str = "{\"crv\":\"" + self.crv + "\",\"kty\":\"EC\",\"x\":\"" + self.x + "\",\"y\":\"" + self.y + "\"}"
            hex_ec: str = nox.crypto.sha256(canonical_ec)
            return encode_base64url_from_hex(hex_ec)
        
        if self.kty == "oct":
            # Lexicographical order: k, kty
            canonical_json: str = "{\"k\":\"" + self.k + "\",\"kty\":\"oct\"}"
            hex_hash: str = nox.crypto.sha256(canonical_json)
            raw_hash: str = hex_to_bytes(hex_hash)
            return encode_base64url(raw_hash)
        
        raise InvalidKeyError("Thumbprint not supported for kty: " + self.kty)

def parse_jwk(jwk_json: str) -> JwkKey:
    v: JsonValue = parse_strict_json(jwk_json)
    if not is_object(v):
        raise JsonFormatError("JWK must be a JSON object")

    if not has_field(v, "kty"):
        raise InvalidKeyError("JWK missing required 'kty' parameter")
    kty: str = get_string_field(v, "kty")
    
    kid: str = get_string_field(v, "kid", default_val="", required=False)
    alg: str = get_string_field(v, "alg", default_val="", required=False)
    use: str = get_string_field(v, "use", default_val="sig", required=False)

    n: str = get_string_field(v, "n", default_val="", required=False)
    e: str = get_string_field(v, "e", default_val="", required=False)
    d: str = get_string_field(v, "d", default_val="", required=False)
    k: str = get_string_field(v, "k", default_val="", required=False)
    crv: str = get_string_field(v, "crv", default_val="", required=False)
    x: str = get_string_field(v, "x", default_val="", required=False)
    y: str = get_string_field(v, "y", default_val="", required=False)

    return JwkKey(kty, kid, alg, use, n, e, d, k, crv, x, y)
