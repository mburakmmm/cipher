# Cipher — JSON Web Key (JWK) and RFC 7638 Thumbprint Standard
# Enforces safe public JWK export (zero private key leakage) and minimum key size requirements.

import nox.crypto
import nox.strings
from encoding import decode_base64url, encode_base64url, hex_to_bytes, validate_base64url_syntax
from errors import EncodingError, InvalidKeyError, JsonFormatError
from json_strict import get_string_field, has_field, is_object, parse_strict_json

MIN_RSA_MODULUS_CHARS: int = 342  # RFC 7518 §3.3: 2048-bit modulus (256 bytes) requires at least 342 unpadded Base64URL characters (2040 bits is only 340 chars)

def _b64_char_to_val(code: int) -> int:
    if code >= 65 and code <= 90:
        return code - 65
    if code >= 97 and code <= 122:
        return code - 71
    if code >= 48 and code <= 57:
        return code + 4
    if code == 45:
        return 62
    if code == 95:
        return 63
    return -1

def _b64url_to_uint(s: str) -> int:
    n: int = len(s)
    rem: int = n % 4
    if n == 0 or rem == 1:
        raise InvalidKeyError("Invalid Base64URL integer length")
    
    val: int = 0
    i: int = 0
    while i < n:
        code: int = ord(s[i])
        c_val: int = _b64_char_to_val(code)
        if c_val < 0:
            raise InvalidKeyError("Invalid character in Base64URL integer")
        val = (val << 6) | c_val
        i = i + 1
    
    if rem == 2:
        return val >> 4
    if rem == 3:
        return val >> 2
    return val

class JwkKey:
    kty: str
    kid: str
    alg: str
    use: str
    # RSA fields
    n: str
    e: str
    d: str
    # Symmetric fields
    k: str

    def __init__(self, kty: str, kid: str = "", alg: str = "", use: str = "sig",
                 n: str = "", e: str = "", d: str = "", k: str = "") -> None:
        self.kty = kty
        self.kid = kid
        self.alg = alg
        self.use = use
        self.n = n
        self.e = e
        self.d = d
        self.k = k

        if self.kty == "RSA":
            if self.n == "" or self.e == "":
                raise InvalidKeyError("RSA JWK must contain both 'n' and 'e' parameters")
            
            # 1. Base64URL syntax validation
            try:
                validate_base64url_syntax(self.n)
            except EncodingError:
                raise InvalidKeyError("RSA modulus 'n' has invalid Base64URL syntax")
            try:
                validate_base64url_syntax(self.e)
            except EncodingError:
                raise InvalidKeyError("RSA public exponent 'e' has invalid Base64URL syntax")

            # 2. Modulus 'n' size and structural validation
            # Enforce minimum 2048 bits (256 bytes) for RSA
            # In Base64URL (RFC 7518 §3.3), a 256-byte modulus encodes to 342 unpadded characters.
            if len(self.n) < MIN_RSA_MODULUS_CHARS:
                raise InvalidKeyError("RSA modulus 'n' must be at least 2048 bits (256 bytes, 342 Base64URL chars)")
            
            n_c0: int = _b64_char_to_val(ord(self.n[0]))
            n_c1: int = _b64_char_to_val(ord(self.n[1]))
            n_first_byte: int = (n_c0 << 2) | (n_c1 >> 4)
            if n_first_byte == 0:
                raise InvalidKeyError("RSA modulus 'n' must not contain leading zero octets (RFC 7518 §6.3.1.1)")
            if len(self.n) == MIN_RSA_MODULUS_CHARS and (n_first_byte & 128) == 0:
                raise InvalidKeyError("RSA modulus 'n' has MSB equal to zero (fewer than 2048 bits)")

            # 3. Public exponent 'e' validation (RFC 7518 §6.3.1.2)
            if len(self.e) == 0 or len(self.e) % 4 == 1:
                raise InvalidKeyError("RSA public exponent 'e' has invalid Base64URL length")
            e_c0: int = _b64_char_to_val(ord(self.e[0]))
            e_c1: int = _b64_char_to_val(ord(self.e[1]))
            e_first_byte: int = (e_c0 << 2) | (e_c1 >> 4)
            if e_first_byte == 0:
                raise InvalidKeyError("RSA exponent 'e' must not contain leading zero octets (RFC 7518 §6.3.1.2)")
            
            e_val: int = _b64url_to_uint(self.e)
            if e_val <= 1:
                raise InvalidKeyError("RSA public exponent 'e' must be greater than 1")
            if e_val % 2 == 0:
                raise InvalidKeyError("RSA public exponent 'e' must be an odd positive integer")
        
        if self.kty == "oct":
            if self.k == "":
                raise InvalidKeyError("Symmetric 'oct' JWK must contain 'k' parameter")

    def is_private(self) -> bool:
        if self.kty == "RSA":
            return self.d != ""
        if self.kty == "oct":
            return True
        return False

    def to_public_json(self) -> str:
        # Invariant: Never export private 'd' or symmetric secret 'k'
        if self.kty == "RSA":
            out: str = "{\"kty\":\"RSA\",\"n\":\"" + self.n + "\",\"e\":\"" + self.e + "\""
            if self.kid != "":
                out = out + ",\"kid\":\"" + self.kid + "\""
            if self.alg != "":
                out = out + ",\"alg\":\"" + self.alg + "\""
            if self.use != "":
                out = out + ",\"use\":\"" + self.use + "\""
            out = out + "}"
            return out
        
        if self.kty == "oct":
            # RFC 7517: Symmetric keys MUST NOT be exported as public JWKs
            raise InvalidKeyError("Symmetric octet keys cannot be exported as public JWK")
        
        raise InvalidKeyError("Unsupported key type for public export: " + self.kty)

    def thumbprint_sha256(self) -> str:
        # RFC 7638 §3.2: Lexicographically ordered required members without whitespace
        if self.kty == "RSA":
            # Lexicographical order: e, kty, n
            canonical_json: str = "{\"e\":\"" + self.e + "\",\"kty\":\"RSA\",\"n\":\"" + self.n + "\"}"
            hex_hash: str = nox.crypto.sha256(canonical_json)
            raw_hash: str = hex_to_bytes(hex_hash)
            return encode_base64url(raw_hash)
        
        if self.kty == "oct":
            # Lexicographical order: k, kty
            canonical_json: str = "{\"k\":\"" + self.k + "\",\"kty\":\"oct\"}"
            hex_hash: str = nox.crypto.sha256(canonical_json)
            raw_hash: str = hex_to_bytes(hex_hash)
            return encode_base64url(raw_hash)
        
        raise InvalidKeyError("Thumbprint not supported for kty: " + self.kty)

def parse_jwk(jwk_json: str) -> JwkKey:
    v: JsonValue = parse_strict_json(jwk_json)
    if not is_object(v):
        raise JsonFormatError("JWK must be a JSON object")

    if not has_field(v, "kty"):
        raise InvalidKeyError("JWK missing required 'kty' parameter")
    kty: str = get_string_field(v, "kty")
    
    kid: str = get_string_field(v, "kid", default_val="", required=False)
    alg: str = get_string_field(v, "alg", default_val="", required=False)
    use: str = get_string_field(v, "use", default_val="sig", required=False)

    n: str = get_string_field(v, "n", default_val="", required=False)
    e: str = get_string_field(v, "e", default_val="", required=False)
    d: str = get_string_field(v, "d", default_val="", required=False)
    k: str = get_string_field(v, "k", default_val="", required=False)

    return JwkKey(kty, kid, alg, use, n, e, d, k)
