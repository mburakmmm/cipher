# Cipher — Secure Remote JWKS Source and Resilient Key Discovery
# Strict SSRF controls, TTL-bounded caching, negative caching, and outage stale-window limits.

import nox.strings
import nox.time
from nox.url import URL, UrlError
import nox.url
from errors import ConfigurationError, KeyUnavailableError, ResourceLimitExceededError, UnknownKeyError
from jwk import JwkKey, parse_jwk
from json_strict import get_field_value, has_field, is_object, parse_strict_json

MAX_JWKS_RESPONSE_BYTES: int = 1048576  # 1 MB maximum JWKS payload
MAX_NEGATIVE_CACHE_ENTRIES: int = 256    # Maximum negative cache capacity to prevent memory exhaustion

def _hex_to_uint16(s: str) -> int:
    n: int = len(s)
    if n == 0 or n > 4:
        return -1
    val: int = 0
    i: int = 0
    while i < n:
        c: int = ord(s[i])
        d: int = -1
        if c >= 48 and c <= 57:
            d = c - 48
        elif c >= 65 and c <= 70:
            d = c - 55
        elif c >= 97 and c <= 102:
            d = c - 87
        else:
            return -1
        val = (val << 4) | d
        i = i + 1
    return val

def _substr(s: str, start: int, end: int) -> str:
    res: str = ""
    i: int = start
    n: int = len(s)
    while i < end and i < n:
        res = res + s[i]
        i = i + 1
    return res

def _is_restricted_ipv6(host: str) -> bool:
    clean: str = host
    if nox.strings.starts_with(clean, "[") and nox.strings.ends_with(clean, "]"):
        clean = nox.strings.replace(nox.strings.replace(clean, "[", ""), "]", "")
    clean = nox.strings.lower(clean)

    # Must contain at least one colon to be IPv6
    if not nox.strings.contains(clean, ":"):
        return False

    # 1. Check for IPv4-mapped or embedded IPv4 address (e.g. ::ffff:192.168.1.1)
    if nox.strings.contains(clean, "."):
        last_colon: int = -1
        c_i: int = len(clean) - 1
        while c_i >= 0:
            if clean[c_i] == ":":
                last_colon = c_i
                break
            c_i = c_i - 1
        if last_colon >= 0:
            v4_part: str = _substr(clean, last_colon + 1, len(clean))
            if _is_restricted_ipv4(v4_part):
                return True
            v6_prefix: str = _substr(clean, 0, last_colon + 1)
            if v6_prefix == "::ffff:" or v6_prefix == "0:0:0:0:0:ffff:":
                return True

    # 2. Check for double colon '::'
    double_colon_count: int = 0
    i: int = 0
    n: int = len(clean)
    while i < n - 1:
        if clean[i] == ":" and clean[i + 1] == ":":
            double_colon_count = double_colon_count + 1
            i = i + 1
        i = i + 1
    if double_colon_count > 1:
        return True  # Invalid IPv6 format fails closed

    # 3. Parse hextets with expansion of '::'
    hextets: list[int] = []
    if double_colon_count == 1:
        parts: list[str] = nox.strings.split(clean, "::")
        left_str: str = parts[0]
        right_str: str = parts[1]

        left_segs: list[str] = []
        if left_str != "":
            left_segs = nox.strings.split(left_str, ":")

        right_segs: list[str] = []
        if right_str != "":
            right_segs = nox.strings.split(right_str, ":")

        valid_right: list[str] = []
        r_i: int = 0
        while r_i < len(right_segs):
            if not nox.strings.contains(right_segs[r_i], "."):
                valid_right.append(right_segs[r_i])
            r_i = r_i + 1

        total_present: int = len(left_segs) + len(valid_right)
        if total_present > 7:
            return True  # Too many hextets fails closed
        zeros_to_insert: int = 8 - total_present

        l_idx: int = 0
        while l_idx < len(left_segs):
            val: int = _hex_to_uint16(left_segs[l_idx])
            if val < 0:
                return True
            hextets.append(val)
            l_idx = l_idx + 1

        z_idx: int = 0
        while z_idx < zeros_to_insert:
            hextets.append(0)
            z_idx = z_idx + 1

        r_idx: int = 0
        while r_idx < len(valid_right):
            val: int = _hex_to_uint16(valid_right[r_idx])
            if val < 0:
                return True
            hextets.append(val)
            r_idx = r_idx + 1
    else:
        segs: list[str] = nox.strings.split(clean, ":")
        if len(segs) != 8:
            return True  # Invalid segment count fails closed
        s_idx: int = 0
        while s_idx < 8:
            val: int = _hex_to_uint16(segs[s_idx])
            if val < 0:
                return True
            hextets.append(val)
            s_idx = s_idx + 1

    if len(hextets) < 8:
        return True

    h0: int = hextets[0]
    h1: int = hextets[1]
    h2: int = hextets[2]
    h3: int = hextets[3]
    h4: int = hextets[4]
    h5: int = hextets[5]
    h6: int = hextets[6]
    h7: int = hextets[7]

    # Loopback (::1)
    if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 0 and h5 == 0 and h6 == 0 and h7 == 1:
        return True

    # Unspecified (::)
    if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 0 and h5 == 0 and h6 == 0 and h7 == 0:
        return True

    # IPv4-mapped (::ffff:0:0/96)
    if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 0 and h5 == 65535:
        b0: int = (h6 >> 8) & 255
        b1: int = h6 & 255
        b2: int = (h7 >> 8) & 255
        b3: int = h7 & 255
        v4_syn: str = str(b0) + "." + str(b1) + "." + str(b2) + "." + str(b3)
        if _is_restricted_ipv4(v4_syn):
            return True

    # RFC 4193 Unique Local Addresses (fc00::/7 -> 0xfc00 to 0xfdff)
    # Bitmask: (h0 & 0xfe00) == 0xfc00 (65024, 64512)
    if (h0 & 65024) == 64512:
        return True

    # RFC 4291 Link-Local Unicast (fe80::/10 -> 0xfe80 to 0xfebf)
    # Bitmask: (h0 & 0xffc0) == 0xfe80 (65472, 65152)
    if (h0 & 65472) == 65152:
        return True

    # RFC 3879 Site-Local Unicast (fec0::/10)
    # Bitmask: (h0 & 0xffc0) == 0xfec0 (65472, 65216)
    if (h0 & 65472) == 65216:
        return True

    # RFC 4291 Multicast (ff00::/8 -> 0xff00 to 0xffff)
    # Bitmask: (h0 & 0xff00) == 0xff00 (65280, 65280)
    if (h0 & 65280) == 65280:
        return True

    # RFC 6666 Discard Prefix (100::/64)
    if h0 == 256 and h1 == 0 and h2 == 0 and h3 == 0:
        return True

    # RFC 3849 Documentation Prefix (2001:db8::/32)
    if h0 == 8193 and h1 == 3512:
        return True

    # RFC 5180 Benchmark Prefix (2001:2::/48)
    if h0 == 8193 and h1 == 2 and h2 == 0:
        return True

    return False

def _is_restricted_ipv4(host: str) -> bool:
    octets: list[str] = nox.strings.split(host, ".")
    if len(octets) != 4:
        return False
    
    b0: int = 0
    b1: int = 0
    b2: int = 0
    b3: int = 0
    try:
        idx: int = 0
        while idx < 4:
            seg: str = octets[idx]
            if len(seg) == 0:
                return True
            if len(seg) > 1 and nox.strings.starts_with(seg, "0"):
                return True
            idx = idx + 1
        
        b0 = int(octets[0])
        b1 = int(octets[1])
        b2 = int(octets[2])
        b3 = int(octets[3])
    except ValueError:
        return True
    
    if b0 < 0 or b0 > 255 or b1 < 0 or b1 > 255 or b2 < 0 or b2 > 255 or b3 < 0 or b3 > 255:
        return True
    
    # 1. RFC 1122 'This host / Current network' (0.0.0.0/8)
    if b0 == 0:
        return True
    # 2. RFC 1918 Private Class A (10.0.0.0/8)
    if b0 == 10:
        return True
    # 3. RFC 6598 Shared Address Space / CGNAT (100.64.0.0/10)
    if b0 == 100 and (b1 >= 64 and b1 <= 127):
        return True
    # 4. RFC 1122 Loopback (127.0.0.0/8)
    if b0 == 127:
        return True
    # 5. RFC 3927 Link-Local (169.254.0.0/16)
    if b0 == 169 and b1 == 254:
        return True
    # 6. RFC 1918 Private Class B (172.16.0.0/12)
    if b0 == 172 and (b1 >= 16 and b1 <= 31):
        return True
    # 7. RFC 6890 IETF Protocol Assignments (192.0.0.0/24)
    if b0 == 192 and b1 == 0 and b2 == 0:
        return True
    # 8. RFC 5737 TEST-NET-1 (192.0.2.0/24)
    if b0 == 192 and b1 == 0 and b2 == 2:
        return True
    # 9. RFC 7526 6to4 Relay Anycast (192.88.99.0/24)
    if b0 == 192 and b1 == 88 and b2 == 99:
        return True
    # 10. RFC 1918 Private Class C (192.168.0.0/16)
    if b0 == 192 and b1 == 168:
        return True
    # 11. RFC 2544 Network Interconnect Benchmark (198.18.0.0/15: 198.18.0.0 - 198.19.255.255)
    if b0 == 198 and (b1 == 18 or b1 == 19):
        return True
    # 12. RFC 5737 TEST-NET-2 (198.51.100.0/24)
    if b0 == 198 and b1 == 51 and b2 == 100:
        return True
    # 13. RFC 5737 TEST-NET-3 (203.0.113.0/24)
    if b0 == 203 and b1 == 0 and b2 == 113:
        return True
    # 14. RFC 5771 Multicast (224.0.0.0/4)
    if b0 >= 224 and b0 <= 239:
        return True
    # 15. RFC 1112 Reserved / Limited Broadcast (240.0.0.0/4)
    if b0 >= 240:
        return True
    
    return False

def verify_resolved_ip(ip_str: str) -> bool:
    clean_ip: str = ip_str
    if nox.strings.starts_with(clean_ip, "[") and nox.strings.ends_with(clean_ip, "]"):
        clean_ip = nox.strings.replace(nox.strings.replace(clean_ip, "[", ""), "]", "")
    clean_ip = nox.strings.lower(clean_ip)

    if clean_ip == "":
        return False

    if nox.strings.contains(clean_ip, ":"):
        if _is_restricted_ipv6(clean_ip):
            return False
        return True

    if nox.strings.contains(clean_ip, "."):
        if _is_restricted_ipv4(clean_ip):
            return False
        return True

    return False

def is_safe_jwks_url(url: str, allowed_host: str = "") -> bool:
    # 1. Standard RFC 3986 URL parsing via nox.url
    u: URL = URL("", "", "", 0, "", {}, "")
    try:
        u = nox.url.parse(url)
    except UrlError:
        return False
    
    # 2. Mandatory HTTPS scheme
    if u.scheme != "https":
        return False
    
    # 3. Userinfo (@) in URL is forbidden (prevents credential hiding and SSRF confusion)
    if u.userinfo != "":
        return False
    
    host: str = u.host
    if nox.strings.starts_with(host, "[") and nox.strings.ends_with(host, "]"):
        host = nox.strings.replace(nox.strings.replace(host, "[", ""), "]", "")
    
    host = nox.strings.lower(host)
    if host == "":
        return False

    # 4. Reject localhost, 0.0.0.0, and metadata hostnames
    if host == "localhost" or host == "0.0.0.0" or host == "metadata.google.internal":
        return False

    # 5. Reject alternative hexadecimal or octal IP representations
    if nox.strings.contains(host, "0x"):
        return False
    
    # Reject pure decimal integer IP addresses (e.g. 2130706433)
    is_pure_digits: bool = True
    d_i: int = 0
    h_len: int = len(host)
    if h_len > 0:
        while d_i < h_len:
            c: int = ord(host[d_i])
            if c < 48 or c > 57:
                is_pure_digits = False
                break
            d_i = d_i + 1
        if is_pure_digits:
            return False

    # 6. Structural IPv6 bitmask validation
    if nox.strings.contains(host, ":"):
        if _is_restricted_ipv6(host):
            return False

    # 7. Structural IPv4 CIDR filtering (covers 14 restricted blocks including CGNAT and Benchmark)
    if nox.strings.contains(host, "."):
        if _is_restricted_ipv4(host):
            return False

    # 8. Whitelisted host matching (if configured)
    if allowed_host != "":
        if host != allowed_host:
            return False

    return True

def parse_jwks(jwks_json: str) -> list[JwkKey]:
    byte_count: int = nox.strings.byte_len(jwks_json)
    if byte_count > MAX_JWKS_RESPONSE_BYTES:
        raise ResourceLimitExceededError("JWKS response exceeds 1MB limit")
    
    v: JsonValue = parse_strict_json(jwks_json)
    if not is_object(v):
        raise ConfigurationError("JWKS payload must be a JSON object")
    
    if not has_field(v, "keys"):
        raise ConfigurationError("JWKS missing required 'keys' array")
    
    keys_val: JsonValue = get_field_value(v, "keys")
    if keys_val.kind != 4:
        raise ConfigurationError("'keys' member must be a JSON array")
    
    out: list[JwkKey] = []
    i: int = 0
    n: int = len(keys_val.arr)
    while i < n:
        raw_key: JsonValue = keys_val.arr[i]
        # dump individual JWK back to string for strict parse_jwk validation
        raw_key_json: str = nox.json.dump(raw_key)
        k: JwkKey = parse_jwk(raw_key_json)
        out.append(k)
        i = i + 1
    
    return out

class JwksKeySource:
    configured_url: str
    allowed_host: str
    cache_ttl_sec: int
    stale_grace_sec: int
    min_retry_interval_sec: int
    keys: list[JwkKey]
    negative_cache_kids: list[str]
    last_fetched_at: int
    last_failed_at: int

    def __init__(self, configured_url: str, allowed_host: str = "",
                 cache_ttl_sec: int = 300, stale_grace_sec: int = 3600,
                 min_retry_interval_sec: int = 15) -> None:
        if not is_safe_jwks_url(configured_url, allowed_host):
            raise ConfigurationError("Insecure or disallowed JWKS URL: " + configured_url)
        
        self.configured_url = configured_url
        self.allowed_host = allowed_host
        self.cache_ttl_sec = cache_ttl_sec
        self.stale_grace_sec = stale_grace_sec
        self.min_retry_interval_sec = min_retry_interval_sec
        self.keys = []
        self.negative_cache_kids = []
        self.last_fetched_at = 0
        self.last_failed_at = 0

    def feed_jwks(self, jwks_json: str, timestamp_sec: int) -> None:
        parsed: list[JwkKey] = parse_jwks(jwks_json)
        self.keys = parsed
        self.last_fetched_at = timestamp_sec
        # Clear negative cache upon fresh successful fetch
        self.negative_cache_kids = []

    def mark_outage(self, timestamp_sec: int) -> None:
        self.last_failed_at = timestamp_sec

    def is_cache_fresh(self, now: int) -> bool:
        if self.last_fetched_at == 0:
            return False
        return now <= self.last_fetched_at + self.cache_ttl_sec

    def is_stale_acceptable(self, now: int) -> bool:
        if self.last_fetched_at == 0:
            return False
        return now <= self.last_fetched_at + self.cache_ttl_sec + self.stale_grace_sec

    def is_in_negative_cache(self, kid: str) -> bool:
        i: int = 0
        n: int = len(self.negative_cache_kids)
        while i < n:
            if self.negative_cache_kids[i] == kid:
                return True
            i = i + 1
        return False

    def record_unknown_kid(self, kid: str) -> None:
        if self.is_in_negative_cache(kid):
            return
        
        # Bounded capacity defense against memory exhaustion
        if len(self.negative_cache_kids) >= MAX_NEGATIVE_CACHE_ENTRIES:
            new_cache: list[str] = []
            k_idx: int = 1
            k_total: int = len(self.negative_cache_kids)
            while k_idx < k_total:
                new_cache.append(self.negative_cache_kids[k_idx])
                k_idx = k_idx + 1
            self.negative_cache_kids = new_cache
            
        self.negative_cache_kids.append(kid)

    def get_key(self, kid: str, current_time_sec: int = 0) -> JwkKey:
        now: int = current_time_sec
        if now <= 0:
            now = nox.time.now_ms() // 1000

        # Negative cache defense against unknown kid fetch storm
        if self.is_in_negative_cache(kid):
            raise UnknownKeyError("Key is negative-cached as non-existent: " + kid)

        # Check cache validity
        if not self.is_cache_fresh(now):
            if not self.is_stale_acceptable(now):
                raise KeyUnavailableError("JWKS cache expired and stale grace window exceeded")

        # Search for key
        i: int = 0
        n: int = len(self.keys)
        while i < n:
            k: JwkKey = self.keys[i]
            if k.kid == kid:
                return k
            i = i + 1
        
        # Record into negative cache to prevent fetch storm
        self.record_unknown_kid(kid)
        raise UnknownKeyError("Key identifier not found in JWKS: " + kid)
