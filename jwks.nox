# Cipher — Secure Remote JWKS Source and Resilient Key Discovery
# Strict SSRF controls, TTL-bounded caching, negative caching, and outage stale-window limits.

import nox.strings
import nox.time
from nox.url import URL, UrlError
import nox.url
from cipher.errors import ConfigurationError, EncodingError, KeyUnavailableError, ResourceLimitExceededError, UnknownKeyError
from cipher.jwk import JwkKey, parse_jwk
from cipher.json_strict import get_field_value, has_field, is_object, parse_strict_json

MAX_JWKS_RESPONSE_BYTES: int = 1048576  # 1 MB maximum JWKS payload
MAX_NEGATIVE_CACHE_ENTRIES: int = 256    # Maximum negative cache capacity to prevent memory exhaustion

class IPv4Address:
    o0: int
    o1: int
    o2: int
    o3: int

    def __init__(self, o0: int, o1: int, o2: int, o3: int) -> None:
        self.o0 = o0
        self.o1 = o1
        self.o2 = o2
        self.o3 = o3

class IPv6Address:
    hextets: list[int]

    def __init__(self, hextets: list[int]) -> None:
        if len(hextets) != 8:
            raise EncodingError("IPv6Address requires exactly 8 16-bit hextets")
        self.hextets = hextets

def _hex_to_uint16(s: str) -> int:
    n: int = len(s)
    if n == 0 or n > 4:
        return -1
    val: int = 0
    i: int = 0
    while i < n:
        c: int = ord(s[i])
        d: int = -1
        if c >= 48 and c <= 57:
            d = c - 48
        elif c >= 65 and c <= 70:
            d = c - 55
        elif c >= 97 and c <= 102:
            d = c - 87
        else:
            return -1
        val = (val << 4) | d
        i = i + 1
    return val

def _substr(s: str, start: int, end: int) -> str:
    res: str = ""
    i: int = start
    n: int = len(s)
    while i < end and i < n:
        res = res + s[i]
        i = i + 1
    return res

def parse_ipv4(s: str) -> IPv4Address:
    if s == "":
        raise EncodingError("Empty IPv4 address")
    octets: list[str] = nox.strings.split(s, ".")
    if len(octets) != 4:
        raise EncodingError("IPv4 address must contain exactly 4 dot-separated octets")

    vals: list[int] = []
    idx: int = 0
    while idx < 4:
        seg: str = octets[idx]
        seg_len: int = len(seg)
        if seg_len == 0 or seg_len > 3:
            raise EncodingError("Invalid IPv4 octet length")
        # Reject leading zeros (prevents octal IP representation ambiguity)
        if seg_len > 1 and seg[0] == "0":
            raise EncodingError("Leading zeros not permitted in IPv4 octets")
        val: int = 0
        c_i: int = 0
        while c_i < seg_len:
            code: int = ord(seg[c_i])
            if code < 48 or code > 57:
                raise EncodingError("Non-digit character in IPv4 octet")
            val = val * 10 + (code - 48)
            c_i = c_i + 1
        if val < 0 or val > 255:
            raise EncodingError("IPv4 octet out of range 0..255")
        vals.append(val)
        idx = idx + 1

    return IPv4Address(vals[0], vals[1], vals[2], vals[3])

def is_restricted_ipv4_addr(addr: IPv4Address) -> bool:
    b0: int = addr.o0
    b1: int = addr.o1
    b2: int = addr.o2

    # 1. RFC 1122 'This host / Current network' (0.0.0.0/8)
    if b0 == 0:
        return True
    # 2. RFC 1918 Private Class A (10.0.0.0/8)
    if b0 == 10:
        return True
    # 3. RFC 6598 Shared Address Space / CGNAT (100.64.0.0/10)
    if b0 == 100 and (b1 >= 64 and b1 <= 127):
        return True
    # 4. RFC 1122 Loopback (127.0.0.0/8)
    if b0 == 127:
        return True
    # 5. RFC 3927 Link-Local / Cloud Metadata (169.254.0.0/16)
    if b0 == 169 and b1 == 254:
        return True
    # 6. RFC 1918 Private Class B (172.16.0.0/12)
    if b0 == 172 and (b1 >= 16 and b1 <= 31):
        return True
    # 7. RFC 6890 IETF Protocol Assignments (192.0.0.0/24)
    if b0 == 192 and b1 == 0 and b2 == 0:
        return True
    # 8. RFC 5737 TEST-NET-1 (192.0.2.0/24)
    if b0 == 192 and b1 == 0 and b2 == 2:
        return True
    # 9. RFC 7526 6to4 Relay Anycast (192.88.99.0/24)
    if b0 == 192 and b1 == 88 and b2 == 99:
        return True
    # 10. RFC 1918 Private Class C (192.168.0.0/16)
    if b0 == 192 and b1 == 168:
        return True
    # 11. RFC 2544 Network Interconnect Benchmark (198.18.0.0/15)
    if b0 == 198 and (b1 == 18 or b1 == 19):
        return True
    # 12. RFC 5737 TEST-NET-2 (198.51.100.0/24)
    if b0 == 198 and b1 == 51 and b2 == 100:
        return True
    # 13. RFC 5737 TEST-NET-3 (203.0.113.0/24)
    if b0 == 203 and b1 == 0 and b2 == 113:
        return True
    # 14. RFC 5771 Multicast (224.0.0.0/4) & RFC 1112 Reserved / Broadcast (240.0.0.0/4)
    if b0 >= 224:
        return True

    return False

def parse_ipv6(s: str) -> IPv6Address:
    if s == "":
        raise EncodingError("Empty IPv6 address")
    clean: str = s
    if nox.strings.starts_with(clean, "["):
        if not nox.strings.ends_with(clean, "]"):
            raise EncodingError("Unclosed bracket in IPv6 address")
        clean = _substr(clean, 1, len(clean) - 1)
    elif nox.strings.ends_with(clean, "]"):
        raise EncodingError("Unmatched closing bracket in IPv6 address")

    clean = nox.strings.lower(clean)
    n: int = len(clean)
    if n < 2:
        raise EncodingError("IPv6 address too short")

    # Reject zone identifiers (%eth0, %25) and whitespace
    if nox.strings.contains(clean, "%") or nox.strings.contains(clean, " "):
        raise EncodingError("Zone identifiers and whitespace are forbidden in IPv6 addresses")

    if not nox.strings.contains(clean, ":"):
        raise EncodingError("IPv6 address must contain colons")

    if nox.strings.contains(clean, ":::"):
        raise EncodingError("Invalid triple colon ':::' in IPv6 address")

    # Reject single leading or trailing colon (unless part of '::')
    if clean[0] == ":" and clean[1] != ":":
        raise EncodingError("IPv6 address cannot start with a single colon")
    if clean[n - 1] == ":" and clean[n - 2] != ":":
        raise EncodingError("IPv6 address cannot end with a single colon")

    halves: list[str] = nox.strings.split(clean, "::")
    if len(halves) > 2:
        raise EncodingError("Multiple '::' zero-compressions are invalid in IPv6")

    hextets: list[int] = []
    if len(halves) == 2:
        left_str: str = halves[0]
        right_str: str = halves[1]

        left_segs: list[str] = []
        if left_str != "":
            left_segs = nox.strings.split(left_str, ":")

        right_segs: list[str] = []
        if right_str != "":
            right_segs = nox.strings.split(right_str, ":")

        left_vals: list[int] = []
        l_i: int = 0
        while l_i < len(left_segs):
            lv: int = _hex_to_uint16(left_segs[l_i])
            if lv < 0:
                raise EncodingError("Invalid hextet in left side of IPv6 address")
            left_vals.append(lv)
            l_i = l_i + 1

        # Parse right segments; ONLY the final segment may be an embedded IPv4 address (contributing 2 hextets)
        right_vals: list[int] = []
        r_i: int = 0
        r_len: int = len(right_segs)
        while r_i < r_len:
            r_seg: str = right_segs[r_i]
            if nox.strings.contains(r_seg, "."):
                if r_i != r_len - 1:
                    raise EncodingError("Embedded IPv4 must be the final segment of an IPv6 address")
                v4: IPv4Address = parse_ipv4(r_seg)
                # RFC 4291: Embedded 32-bit IPv4 occupies exactly TWO 16-bit hextets
                right_vals.append((v4.o0 << 8) | v4.o1)
                right_vals.append((v4.o2 << 8) | v4.o3)
            else:
                rv: int = _hex_to_uint16(r_seg)
                if rv < 0:
                    raise EncodingError("Invalid hextet in right side of IPv6 address")
                right_vals.append(rv)
            r_i = r_i + 1

        total_hextets: int = len(left_vals) + len(right_vals)
        if total_hextets > 7:
            raise EncodingError("Too many hextets in '::'-compressed IPv6 address")
        zeros_needed: int = 8 - total_hextets

        idx1: int = 0
        while idx1 < len(left_vals):
            hextets.append(left_vals[idx1])
            idx1 = idx1 + 1
        idx_z: int = 0
        while idx_z < zeros_needed:
            hextets.append(0)
            idx_z = idx_z + 1
        idx2: int = 0
        while idx2 < len(right_vals):
            hextets.append(right_vals[idx2])
            idx2 = idx2 + 1
    else:
        segs: list[str] = nox.strings.split(clean, ":")
        s_i: int = 0
        s_len: int = len(segs)
        while s_i < s_len:
            seg_str: str = segs[s_i]
            if nox.strings.contains(seg_str, "."):
                if s_i != s_len - 1:
                    raise EncodingError("Embedded IPv4 must be the final segment of an IPv6 address")
                v4_full: IPv4Address = parse_ipv4(seg_str)
                hextets.append((v4_full.o0 << 8) | v4_full.o1)
                hextets.append((v4_full.o2 << 8) | v4_full.o3)
            else:
                sv: int = _hex_to_uint16(seg_str)
                if sv < 0:
                    raise EncodingError("Invalid hextet in IPv6 address")
                hextets.append(sv)
            s_i = s_i + 1

        if len(hextets) != 8:
            raise EncodingError("Uncompressed IPv6 address must evaluate to exactly 8 hextets")

    return IPv6Address(hextets)

def is_restricted_ipv6_addr(addr: IPv6Address) -> bool:
    h0: int = addr.hextets[0]
    h1: int = addr.hextets[1]
    h2: int = addr.hextets[2]
    h3: int = addr.hextets[3]
    h4: int = addr.hextets[4]
    h5: int = addr.hextets[5]
    h6: int = addr.hextets[6]
    h7: int = addr.hextets[7]

    # 1. Unspecified (::/128) and Loopback (::1/128) and IPv4-Compatible (::/96, deprecated RFC 4291)
    if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 0 and h5 == 0:
        return True

    # 2. IPv4-Mapped IPv6 (::ffff:0:0/96 -> h0..h4 == 0, h5 == 0xffff)
    # Evaluates the embedded 32-bit IPv4 address (h6, h7) against the 14 restricted IPv4 CIDRs
    if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 0 and h5 == 65535:
        mapped_v4: IPv4Address = IPv4Address((h6 >> 8) & 255, h6 & 255, (h7 >> 8) & 255, h7 & 255)
        return is_restricted_ipv4_addr(mapped_v4)

    # 3. IPv4-Translated (::ffff:0:0:0/96, RFC 2765 SIIT)
    if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 65535 and h5 == 0:
        return True

    # 4. NAT64 Well-Known Prefix (64:ff9b::/96 RFC 6052) & Local-Use NAT64 (64:ff9b:1::/48 RFC 8215)
    if h0 == 100 and h1 == 65435:
        return True

    # 5. 6to4 Tunneling (2002::/16 RFC 3056)
    if h0 == 8194:
        return True

    # 6. RFC 4193 Unique Local Addresses (fc00::/7 -> 0xfc00 to 0xfdff)
    # Bitmask: (h0 & 0xfe00) == 0xfc00 (65024, 64512)
    if (h0 & 65024) == 64512:
        return True

    # 7. RFC 4291 Link-Local Unicast (fe80::/10 -> 0xfe80 to 0xfebf)
    # Bitmask: (h0 & 0xffc0) == 0xfe80 (65472, 65152)
    if (h0 & 65472) == 65152:
        return True

    # 8. RFC 3879 Site-Local Unicast (fec0::/10)
    # Bitmask: (h0 & 0xffc0) == 0xfec0 (65472, 65216)
    if (h0 & 65472) == 65216:
        return True

    # 9. RFC 4291 Multicast (ff00::/8 -> 0xff00 to 0xffff)
    # Bitmask: (h0 & 0xff00) == 0xff00 (65280, 65280)
    if (h0 & 65280) == 65280:
        return True

    # 10. RFC 6666 Discard-Only Prefix (100::/64)
    if h0 == 256 and h1 == 0 and h2 == 0 and h3 == 0:
        return True

    # 11. RFC 2928 IETF Protocol Assignments & Teredo (2001::/23 -> h0 == 0x2001, (h1 & 0xfe00) == 0)
    if h0 == 8193 and (h1 & 65024) == 0:
        return True

    # 12. RFC 3849 Documentation Prefix (2001:db8::/32) & RFC 9637 (3fff::/20)
    if (h0 == 8193 and h1 == 3512) or (h0 == 16383 and (h1 & 61440) == 0):
        return True

    return False

def _is_restricted_ipv6(host: str) -> bool:
    try:
        v6: IPv6Address = parse_ipv6(host)
        return is_restricted_ipv6_addr(v6)
    except EncodingError:
        return True  # Invalid IPv6 syntax fails closed as restricted

def _is_restricted_ipv4(host: str) -> bool:
    try:
        v4: IPv4Address = parse_ipv4(host)
        return is_restricted_ipv4_addr(v4)
    except EncodingError:
        return True  # Invalid IPv4 syntax fails closed as restricted

def _looks_like_ipv4_literal(host: str) -> bool:
    # A host with dots whose last label starts with a digit or consists only of digits/dots
    # cannot be a valid DNS hostname (RFC 1123 TLD cannot be numeric) and must be parsed as IPv4.
    parts: list[str] = nox.strings.split(host, ".")
    if len(parts) == 0:
        return False
    last: str = parts[len(parts) - 1]
    if last == "":
        return True
    first_c: int = ord(last[0])
    if first_c >= 48 and first_c <= 57:
        return True
    return False

def verify_resolved_ip(ip_str: str) -> bool:
    if ip_str == "":
        return False
    if nox.strings.contains(ip_str, ":"):
        try:
            v6: IPv6Address = parse_ipv6(ip_str)
            if is_restricted_ipv6_addr(v6):
                return False
            return True
        except EncodingError:
            return False
    else:
        try:
            v4: IPv4Address = parse_ipv4(ip_str)
            if is_restricted_ipv4_addr(v4):
                return False
            return True
        except EncodingError:
            return False

def is_safe_jwks_url(url: str, allowed_host: str = "") -> bool:
    # 1. Standard RFC 3986 URL parsing via nox.url
    u: URL = URL("", "", "", 0, "", {}, "")
    try:
        u = nox.url.parse(url)
    except UrlError:
        return False
    
    # 2. Mandatory HTTPS scheme
    if u.scheme != "https":
        return False
    
    # 3. Userinfo (@) in URL is forbidden (prevents credential hiding and SSRF confusion)
    if u.userinfo != "":
        return False
    
    host: str = u.host
    if nox.strings.starts_with(host, "[") and nox.strings.ends_with(host, "]"):
        host = _substr(host, 1, len(host) - 1)
    
    host = nox.strings.lower(host)
    if host == "":
        return False

    # 4. Reject localhost, 0.0.0.0, and metadata hostnames
    if host == "localhost" or host == "0.0.0.0" or host == "metadata.google.internal":
        return False

    # 5. Reject alternative hexadecimal IP representations
    if nox.strings.contains(host, "0x"):
        return False
    
    # Reject pure decimal integer IP addresses (e.g. 2130706433)
    is_pure_digits: bool = True
    d_i: int = 0
    h_len: int = len(host)
    if h_len > 0:
        while d_i < h_len:
            c: int = ord(host[d_i])
            if c < 48 or c > 57:
                is_pure_digits = False
                break
            d_i = d_i + 1
        if is_pure_digits:
            return False

    # 6. Decoupled IPv6 syntax parsing & SSRF policy validation
    if nox.strings.contains(host, ":"):
        try:
            v6: IPv6Address = parse_ipv6(host)
            # Disallow IPv4-mapped IPv6 literals directly in JWKS URLs or if mapped IP is restricted
            if v6.hextets[0] == 0 and v6.hextets[1] == 0 and v6.hextets[2] == 0 and v6.hextets[3] == 0 and v6.hextets[4] == 0 and v6.hextets[5] == 65535:
                return False
            if is_restricted_ipv6_addr(v6):
                return False
        except EncodingError:
            return False

    # 7. Decoupled IPv4 syntax parsing & 14-CIDR SSRF policy validation
    if nox.strings.contains(host, ".") and _looks_like_ipv4_literal(host):
        try:
            v4: IPv4Address = parse_ipv4(host)
            if is_restricted_ipv4_addr(v4):
                return False
        except EncodingError:
            return False

    # 8. Whitelisted host matching (if configured)
    if allowed_host != "":
        if host != allowed_host:
            return False

    return True

def parse_jwks(jwks_json: str) -> list[JwkKey]:
    byte_count: int = nox.strings.byte_len(jwks_json)
    if byte_count > MAX_JWKS_RESPONSE_BYTES:
        raise ResourceLimitExceededError("JWKS response exceeds 1MB limit")
    
    v: JsonValue = parse_strict_json(jwks_json)
    if not is_object(v):
        raise ConfigurationError("JWKS payload must be a JSON object")
    
    if not has_field(v, "keys"):
        raise ConfigurationError("JWKS missing required 'keys' array")
    
    keys_val: JsonValue = get_field_value(v, "keys")
    if keys_val.kind != 4:
        raise ConfigurationError("'keys' member must be a JSON array")
    
    out: list[JwkKey] = []
    i: int = 0
    n: int = len(keys_val.arr)
    while i < n:
        raw_key: JsonValue = keys_val.arr[i]
        # dump individual JWK back to string for strict parse_jwk validation
        raw_key_json: str = nox.json.dump(raw_key)
        k: JwkKey = parse_jwk(raw_key_json)
        out.append(k)
        i = i + 1
    
    return out

class JwksKeySource:
    configured_url: str
    allowed_host: str
    cache_ttl_sec: int
    stale_grace_sec: int
    min_retry_interval_sec: int
    keys: list[JwkKey]
    negative_cache_kids: list[str]
    last_fetched_at: int
    last_failed_at: int

    def __init__(self, configured_url: str, allowed_host: str = "",
                 cache_ttl_sec: int = 300, stale_grace_sec: int = 3600,
                 min_retry_interval_sec: int = 15) -> None:
        if not is_safe_jwks_url(configured_url, allowed_host):
            raise ConfigurationError("Insecure or disallowed JWKS URL: " + configured_url)
        
        self.configured_url = configured_url
        self.allowed_host = allowed_host
        self.cache_ttl_sec = cache_ttl_sec
        self.stale_grace_sec = stale_grace_sec
        self.min_retry_interval_sec = min_retry_interval_sec
        self.keys = []
        self.negative_cache_kids = []
        self.last_fetched_at = 0
        self.last_failed_at = 0

    def feed_jwks(self, jwks_json: str, timestamp_sec: int) -> None:
        parsed: list[JwkKey] = parse_jwks(jwks_json)
        self.keys = parsed
        self.last_fetched_at = timestamp_sec
        # Clear negative cache upon fresh successful fetch
        self.negative_cache_kids = []

    def mark_outage(self, timestamp_sec: int) -> None:
        self.last_failed_at = timestamp_sec

    def is_cache_fresh(self, now: int) -> bool:
        if self.last_fetched_at == 0:
            return False
        return now <= self.last_fetched_at + self.cache_ttl_sec

    def is_stale_acceptable(self, now: int) -> bool:
        if self.last_fetched_at == 0:
            return False
        return now <= self.last_fetched_at + self.cache_ttl_sec + self.stale_grace_sec

    def is_in_negative_cache(self, kid: str) -> bool:
        i: int = 0
        n: int = len(self.negative_cache_kids)
        while i < n:
            if self.negative_cache_kids[i] == kid:
                return True
            i = i + 1
        return False

    def record_unknown_kid(self, kid: str) -> None:
        if self.is_in_negative_cache(kid):
            return
        
        # Bounded capacity defense against memory exhaustion
        if len(self.negative_cache_kids) >= MAX_NEGATIVE_CACHE_ENTRIES:
            new_cache: list[str] = []
            k_idx: int = 1
            k_total: int = len(self.negative_cache_kids)
            while k_idx < k_total:
                new_cache.append(self.negative_cache_kids[k_idx])
                k_idx = k_idx + 1
            self.negative_cache_kids = new_cache
            
        self.negative_cache_kids.append(kid)

    def get_key(self, kid: str, current_time_sec: int = 0) -> JwkKey:
        now: int = current_time_sec
        if now <= 0:
            now = nox.time.now_ms() // 1000

        # Negative cache defense against unknown kid fetch storm
        if self.is_in_negative_cache(kid):
            raise UnknownKeyError("Key is negative-cached as non-existent: " + kid)

        # Check cache validity
        if not self.is_cache_fresh(now):
            if not self.is_stale_acceptable(now):
                raise KeyUnavailableError("JWKS cache expired and stale grace window exceeded")

        # Search for key
        i: int = 0
        n: int = len(self.keys)
        while i < n:
            k: JwkKey = self.keys[i]
            if k.kid == kid:
                return k
            i = i + 1
        
        # Record into negative cache to prevent fetch storm
        self.record_unknown_kid(kid)
        raise UnknownKeyError("Key identifier not found in JWKS: " + kid)
